---
/**
 * Der Gedankenraum — ein Museum aus Gedanken. Jede Note mit eigenem Banner
 * ist ein hoher Saal (Saal, Kabinett, Galerie oder Rotunde), ihre Links sind
 * Türen, ihr geheimnisvoller Satz steht leise Ton in Ton über dem Bild, das
 * Wandschild daneben erzählt die Note. Man tritt ein über ein Osterei:
 * Doppelklick aufs Banner einer Note (`/raum-tor.js`). Kein Menüpunkt, kein
 * Suchtreffer — ein Ort zum Entdecken. Bau und Bauplan: `public/raum/museum.js`.
 */
import { BUILD, SITE } from "../../lib/site.mjs";
---
<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Gedankenraum — Gedankenwelten</title>
<style is:inline>
  /* Parisienne (Astigmatic, SIL Open Font License) — lokal, nicht von Google */
  @font-face { font-family: "Parisienne"; font-style: normal; font-weight: 400; font-display: block;
    src: url("/schrift/parisienne-latin-ext.woff2") format("woff2");
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }
  @font-face { font-family: "Parisienne"; font-style: normal; font-weight: 400; font-display: block;
    src: url("/schrift/parisienne-latin.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
  @font-face { font-family: "Literata"; font-style: normal; font-weight: 400 700; font-display: swap;
    src: url("/schrift/literata-normal-latin.woff2") format("woff2"); }
  :root { --tinte: #2b2621; --hell: #f3eee6; }
  html, body { margin: 0; height: 100%; background: #1c1916; overflow: hidden; overscroll-behavior: none; }
  canvas#c { position: fixed; inset: 0; width: 100vw; height: 100vh; display: block; touch-action: none; }

  #buehne3d { position: fixed !important; inset: 0; z-index: 3; pointer-events: none; }
  #seite { border: 0; background: #faf7f1; opacity: 0; pointer-events: none; transition: opacity .7s ease; }
  #seite.offen { pointer-events: auto; }

  /* Das Rätsel: ein Satz, der nichts verrät. */
  #raetsel {
    position: fixed; left: 50%; bottom: 8vh; transform: translateX(-50%);
    width: min(40rem, calc(100vw - 32px)); text-align: center;
    font: italic 400 clamp(1.05rem, 1.6vw, 1.4rem)/1.5 "Literata", Georgia, serif;
    color: var(--hell); letter-spacing: .01em; text-shadow: 0 0 18px rgba(0,0,0,.95);
    opacity: 0; transition: opacity 1.4s ease; pointer-events: none; z-index: 2;
  }
  #raetsel.da { opacity: .94; }

  #zurueck {
    position: fixed; bottom: max(18px, env(safe-area-inset-bottom)); left: 18px; z-index: 6; width: 46px; height: 46px; padding: 0;
    border-radius: 50%; border: 1px solid rgba(243,238,230,.35); background: rgba(28,25,22,.62);
    backdrop-filter: blur(6px); color: var(--hell); cursor: pointer;
    opacity: 0; pointer-events: none; transition: opacity .6s ease, transform .3s ease;
  }
  #zurueck.da { opacity: 1; pointer-events: auto; }
  #zurueck:hover { transform: scale(1.08); }

  /* Der Saaltext: was das Wandschild neben dem großen Bild erzählt, wenn man es antippt. */
  #saaltext {
    position: fixed; left: 50%; bottom: max(28px, calc(env(safe-area-inset-bottom) + 16px)); z-index: 4;
    width: min(34rem, calc(100vw - 32px)); box-sizing: border-box; padding: 1.5rem 1.7rem 1.6rem;
    background: #f6f2ea; color: var(--tinte); border-radius: 3px;
    box-shadow: 0 1px 0 rgba(255,255,255,.6) inset, 0 18px 50px rgba(0,0,0,.45), 0 2px 6px rgba(0,0,0,.25);
    transform: translate(-50%, 14px); opacity: 0; pointer-events: none;
    transition: opacity .7s ease, transform .9s cubic-bezier(.2,.7,.2,1);
    max-height: calc(100vh - 56px); overflow: auto;
  }
  #saaltext.da { opacity: 1; transform: translate(-50%, 0); pointer-events: auto; }
  #saaltext .rubrik { font: 600 .66rem/1 ui-sans-serif, system-ui, sans-serif; letter-spacing: .2em; text-transform: uppercase; color: #6d645a; }
  #saaltext .rubrik i { display: inline-block; width: .5rem; height: .5rem; border-radius: 50%; margin-right: .5rem; vertical-align: .02rem; }
  #saaltext h2 { margin: .7rem 0 .2rem; font: 600 1.32rem/1.25 "Literata", Georgia, serif; }
  #saaltext .datum { font: 400 .74rem/1 ui-sans-serif, system-ui, sans-serif; color: #8a8076; letter-spacing: .04em; }
  #saaltext p { margin: 1rem 0 0; font: 400 1.02rem/1.6 "Literata", Georgia, serif; }
  #saaltext hr { border: 0; border-top: 1px solid #ddd5c8; margin: 1rem 0 0; }

  #schleier { position: fixed; inset: 0; background: #1c1916; z-index: 8; pointer-events: none; transition: opacity 2.6s ease; }
  #hinweis {
    position: fixed; left: 50%; bottom: max(16px, env(safe-area-inset-bottom)); transform: translateX(-50%); z-index: 2;
    font: 500 .68rem/1.9 ui-sans-serif, system-ui, sans-serif; letter-spacing: .16em; text-transform: uppercase;
    color: rgba(243,238,230,.7); transition: opacity 2s ease; pointer-events: none; text-align: center;
    max-width: calc(100vw - 32px); width: max-content; padding: .45rem 1.1rem; border-radius: 999px;
    background: rgba(28,25,22,.66); backdrop-filter: blur(6px);
  }
  #hinweis b { font-weight: 600; color: rgba(243,238,230,.9); }
</style>
<meta name="robots" content="noindex">
<meta name="description" content="Ein Museum aus Gedanken: Jede Note ist ein Saal, ihre Verbindungen sind Türen.">
<link rel="icon" href="/gedankenwelten-favicon-64.png">
<link rel="preload" href="/schrift/parisienne-latin.woff2" as="font" type="font/woff2" crossorigin>
<script type="importmap" is:inline>
  { "imports": {
      "three": "/raum/vendor/three.module.min.js",
      "three/addons/renderers/CSS3DRenderer.js": "/raum/vendor/CSS3DRenderer.js"
  } }
</script>
<script is:inline>try { const u = new URL(location.href), q = u.searchParams; if (q.has("nicht-zaehlen")) localStorage.setItem("umami.disabled", "1"); if (q.has("wieder-zaehlen")) localStorage.removeItem("umami.disabled"); } catch {}</script>
<script is:inline>window.umamiKnapp = (_typ, p) => { delete p.screen; delete p.language; return p; };</script>
<script defer src={`${SITE.umami.host}/script.js`} data-website-id={SITE.umami.id} data-before-send="umamiKnapp"></script>
</head>
<body>
  <canvas id="c"></canvas>
  <div id="raetsel"></div>
  <div id="saaltext" role="dialog" aria-label="Saaltext"></div>
  <button id="zurueck" aria-label="Zurück ins Museum" title="Zurück ins Museum">
    <svg viewBox="0 0 46 46" width="46" height="46" fill="none" stroke="currentColor" stroke-width="1.2">
      <path d="M14 33 V21 a9 9 0 0 1 18 0 V33" opacity=".85"/><path d="M10 33 H36" opacity=".5"/>
    </svg>
  </button>
  <div id="hinweis">
    <b>Ziehen</b> schaut · <b>Boden</b> antippen geht hin · <b>Bild</b> antippen wendet es zu · <b>Tür</b> führt weiter · <b>WASD</b>
  </div>
  <div id="schleier"></div>
  <script type="module" src={`/raum/museum.js?v=${BUILD}`} is:inline></script>
</body>
</html>
