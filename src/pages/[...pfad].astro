---
import { getCollection, render } from "astro:content";
import Note from "../layouts/Note.astro";
import { slugify } from "../lib/slug.mjs";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  /* Die beiden alten Quartz-Deckblätter (`Zeitgeist/index`, `GoodNews/index`,
     `Vipassana/index`) bekommen keine Seite: Ihre Adresse ist die der
     Rubrikseite, und die gibt es hier schon. */
  return notes.filter((n) => n.id.split("/").pop().toLowerCase() !== "index").map((note) => {
    const [rubrik, ...rest] = note.id.split("/");
    return {
      params: { pfad: `${rubrik}/${slugify(rest.join("/"))}` },
      props: { note },
    };
  });
}

const { note } = Astro.props;
const { Content, remarkPluginFrontmatter: kopf } = await render(note);
---
<Note note={note} kopf={kopf}>
  <Content />
</Note>
