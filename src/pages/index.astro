---
import { BUILD } from "../lib/site.mjs";
/**
 * Die Startseite — zwei Zugänge, einer davon der Grundzustand.
 *
 * Sie war zuerst nur ein Weg: sieben Stationen, an geschriebenen
 * Verbindungen entlang rückwärts durch die Zeit. Als Idee gut, als
 * Startseite falsch — sie beginnt mit *einer* Note groß, und das liest
 * sich als Behauptung, dass ausgerechnet diese wichtig sei. Wer ankommt,
 * will erst sehen, was da ist.
 *
 * Also: **Das Feld ist der Grundzustand** — alle Notes als Karten, nach
 * Datum, nach Rubrik filterbar. Das ist der journalistische Teil:
 * Übersicht, Gleichrang, selbst entscheiden. **Der Faden bleibt als
 * Angebot** hinter einem Knopf. Das ist der kuratierte Teil: eine
 * Strecke, eine Handschrift. Was einer lieber mag, merkt sich der Browser.
 */
import "../styles/note.css";
import "../styles/stern.css";
import "../styles/start.css";
import { alleFaeden, alleWege } from "../lib/faden.mjs";
import { ladeIndex, rubrikBild } from "../lib/notizen.mjs";
import { ladeGraph, sternFuer } from "../lib/graph.mjs";
import { alleRubriken, themenwolke } from "../lib/rubriken.mjs";
import { wiederkehrDieserWoche, gefundenDieserWoche, meistgelesen } from "../lib/wiederkehr.mjs";
import Suche from "../components/Suche.astro";
import Kopfleiste from "../components/Kopfleiste.astro";
import Kopf from "../components/Kopf.astro";
import Fusszeile from "../components/Fusszeile.astro";
import Schau from "../components/Schau.astro";
import "../styles/mobil.css";

const faeden = alleFaeden(7);
const idx = ladeIndex();
const g = ladeGraph();

/* Ohne die Kataloge und ohne die beiden alten Quartz-Deckblätter
   (`Zeitgeist/index`, `GoodNews/index`) — sonst zählte das Feld einen
   Bestand, den die Rubrikseite daneben anders zählt. */
const notes = idx.alle.filter((n) => !g.katalog.has(n.id) && n.basis.toLowerCase() !== "index");
const datiert = notes.map((n) => n.datum).filter(Boolean).sort();
const [erstesDatum, letztesDatum] = [datiert[0], datiert[datiert.length - 1]];

/* Das Feld zeigt, was gedacht wurde — nicht, wer gedacht hat.
   Die 269 DenkerVitas sind ein Register: Herkunft, Werk, Kernthesen zu
   einer Person. Als Karte neben einer Note stehen sie im falschen Rang,
   und sie sind ein gutes Drittel des Bestands — sie würden das Feld
   fluten. Erreichbar bleiben sie über die Rubrikwahl im Kopf, über die
   Suche und über jede Note, die auf ihren Menschen verweist. */
const OHNE_IM_FELD = new Set(["DenkerVita"]);
const inhaltlich = notes.filter((n) => !OHNE_IM_FELD.has(n.rubrik));
const vitaZahl = notes.length - inhaltlich.length;

const rubriken = alleRubriken().filter((r) => !OHNE_IM_FELD.has(r.name));

/* Die Themen über alle Rubriken (→ rubriken.mjs). Jede Karte trägt nur
   die Themen, die in der Wolke stehen — der Filter braucht keine anderen. */
const wolke = themenwolke(inhaltlich);
const inWolke = new Set(wolke.map((t) => t.name));

/* Neueste zuerst. Notes ohne Datum ganz nach hinten — sie sind nicht
   neu, sie sind nur undatiert. */
const feld = [...inhaltlich].sort((a, b) =>
  String(b.datum ?? "").localeCompare(String(a.datum ?? "")));

/* ── Die Nachbarschaft jeder Karte ──
   Für das Aufklappen an Ort und Stelle: Welche Karten treten hervor, wenn
   man bei einer „Verwandtes" drückt. Als *Platznummern*, nicht als
   Kennungen — die Karten stehen ja schon alle im Dokument, es geht nur
   darum, welche gemeint sind. Fünfhundert Ziffernlisten wiegen ein paar
   Kilobyte; dieselben Verweise als Pfade wären das Zehnfache.

   Nachbarn aus dem Register (DenkerVita) fallen weg: Sie haben im Feld
   keine Karte, auf die man zeigen könnte. Wer den ganzen Stern will,
   findet ihn am Fuß der Note. */
/* Welche Karte überhaupt einen Faden anbieten kann. `alleWege` rechnet
   das einmal für den ganzen Bestand; `faeden.json` daneben greift auf
   denselben Speicher zu, statt fünfhundert Wege ein zweites Mal zu suchen. */
const wege = alleWege(7);

/* Die Wiederkehr: drei Zeilen zu je zwei Karten, mitten im Feld — nicht
   oben, sonst sähe, wer die Seite betritt, jede Woche dasselbe Bild zuerst.
   Nach neun Karten (drei volle Reihen am Schreibtisch) *Wiedergelesen*
   (Pool `Wiederkehr.md`, jede Woche eine andere, mit echtem Datum) und
   *Gefunden* (wohin die Suche die Leser in dreißig Tagen brachte, älter
   als zwei Wochen); nach achtzehn die Meistgelesenen der Woche und des
   Monats, nach siebenundzwanzig die des Jahres und seit Beginn. Was eine
   Karte schon zeigt, überspringt die nächste. */
const WIEDERKEHR_NACH = [9, 18, 27];
const gezeigt = new Set();
const nimm = (art, e, satz) => {
  if (!e) return null;
  gezeigt.add(e.note.id);
  // Satz aus dem Pool, sonst die Beschreibung, sonst der Anfang der Note.
  return { art, note: e.note, satz: satz ?? e.note.beschreibung ?? e.note.auszug };
};
const heute = new Date();
const wiederkehr = wiederkehrDieserWoche(heute);
const zeilen = [
  [nimm("Wiedergelesen", wiederkehr, wiederkehr?.warum), nimm("Gefunden", gefundenDieserWoche(heute, gezeigt))],
  [nimm("Meistgelesen · Woche", meistgelesen("woche", gezeigt, heute)), nimm("Meistgelesen · Monat", meistgelesen("monat", gezeigt, heute))],
  [nimm("Meistgelesen · Jahr", meistgelesen("jahr", gezeigt, heute)), nimm("Meistgelesen · Insgesamt", meistgelesen("immer", gezeigt, heute))],
].map((z) => z.filter(Boolean));
const zeileNach = new Map(WIEDERKEHR_NACH.map((n, i) => [n, zeilen[i]]).filter(([, z]) => z.length));

const platz = new Map(feld.map((n, i) => [n.id, i]));
const nachbarschaft = feld.map((n) => {
  const stern = sternFuer(n.id, 14);
  if (!stern) return [];
  return stern.nodes
    .filter((k) => !k.mitte)
    .map((k) => platz.get(k.id))
    .filter((i) => i !== undefined);
});

/* ── Das Sieb ──
   Was eine Karte außer Titel und Teaser (die stehen ohnehin im Dokument)
   noch findbar macht: ihre Tags und die Namen der Menschen, auf deren
   Vita sie verweist. Wer „Arendt" tippt, soll auch die Note finden, in
   der Arendt nur eine Stimme unter mehreren ist. Die Vitas selbst haben
   keine Karte — sie kommen als Liste mit, damit das Sieb auf sie zeigen
   kann, statt so zu tun, als gäbe es sie nicht. */
const vitaName = (n) => (n.titel ?? n.basis).replace(/\s*—\s*DenkerVita\s*$/i, "").trim();
const vitas = notes.filter((n) => n.rubrik === "DenkerVita").map((n) => ({ n: vitaName(n), u: n.url }));
const markenVon = (n) => [
  ...n.tags,
  ...[...(g.hinaus.get(n.id) ?? [])]
    .map((id) => g.knoten.get(id))
    .filter((k) => k?.rubrik === "DenkerVita")
    .map(vitaName),
].join(" ");

/* Wie viele Karten sichtbar starten. Alle stehen im Dokument — sonst
   könnte der Rubrikfilter nicht sofort antworten, und ein Filter, der
   erst lädt, ist zäher als gar keiner. Sichtbar ist erst dieser Anfang. */
const ERSTE_LADUNG = 48;

/* Die Zeitleiste läuft von heute nach unten in die Vergangenheit — lesen
   heißt hier zurückgehen. Der Anteil sagt, wie weit eine Station liegt. */
const spanne = Date.parse(letztesDatum) - Date.parse(erstesDatum) || 1;
const tiefe = (d) => (d ? (Date.parse(letztesDatum) - Date.parse(d)) / spanne : 0);

const MONATE = ["Januar","Februar","März","April","Mai","Juni","Juli","August","September","Oktober","November","Dezember"];
const langDatum = (d) => {
  if (!d) return null;
  const [j, m, t] = d.split("-");
  return `${Number(t)}. ${MONATE[Number(m) - 1]} ${j}`;
};
const kurzDatum = (d) => {
  if (!d) return null;
  const [j, m, t] = d.split("-");
  return `${Number(t)}.${Number(m)}.${j.slice(2)}`;
};
const monatJahr = (d) => {
  const [j, m] = d.split("-");
  return `${MONATE[Number(m) - 1]} ${j}`;
};
// Die Leiste ist 4,5 rem breit — „September 2026" passt dort nicht hinein.
const kurzMonat = (d) => {
  const [j, m] = d.split("-");
  return `${MONATE[Number(m) - 1].slice(0, 3)} ${j.slice(2)}`;
};
---
<!DOCTYPE html>
<html lang="de" data-theme="hell">
<head>
  <Kopf beschreibung={`Jeder Mensch hat seine eigene Gedankenwelt. ${notes.length} Notes — Zeitgeist, Denker, Geistesblitz, Kultur, Spuren — gelesen, gegengeprüft und verbunden.`} art="website" />
  {/* Die Ansicht muss vor dem ersten Bild feststehen: Stünde sie erst am
      Fuß der Seite, sähe jeder Faden-Leser zuerst das Feld aufblitzen. */}
  <script is:inline>
    try {
      if (localStorage.getItem("gw-ansicht") === "faden")
        document.documentElement.dataset.ansicht = "faden";
    } catch {}
  </script>
</head>
<body class="ist-start">

<Kopfleiste />

{/* Die Zeitleiste gehört zum Faden — sie zeigt, wie weit man sich beim
    Gehen vom Neuesten entfernt hat. Im Feld hätte sie nichts zu sagen. */}
<div class="rail" id="rail" data-von={erstesDatum} data-bis={letztesDatum}>
  <div class="rail__cap rail__cap--oben">{kurzMonat(letztesDatum)}</div>
  <div class="rail__line"></div>
  <div class="rail__cap rail__cap--unten">{kurzMonat(erstesDatum)}</div>
</div>

<main class="start">

  <header class="start__kopf">
    {/* Die gemalte Wortmarke — hier und nur hier, als Auftakt. Sie wechselt
        mit dem Kalendertag (Vorspann setzt `data-wm`) und mit dem Thema
        (`leser.js` tauscht das Bild am selben Knopf). Das Wort darunter
        trägt, bis das Bild da ist, und bleibt stehen, wenn es nie kommt.
        Die Quelle wird erst hier gesetzt, nicht im Markup: Stünde sie dort,
        holte der Browser die Marke des Bautags im hellen Thema, bevor
        irgendwer sie korrigieren kann — zwei Bilder für eine Marke. */}
    <h1 class="wortmarke">
      <span class="wortmarke__wort">Gedanken&shy;welten</span>
      <img class="wortmarke__bild" id="wortmarke" alt="Gedankenwelten" decoding="async">
    </h1>
    <script is:inline>
      {
        const w = document.documentElement, b = document.getElementById("wortmarke");
        b.src = `/wortmarke/wordmark-${w.dataset.wm}-${w.dataset.theme === "dunkel" ? "dark" : "light"}.png`;
        b.dataset.stil = w.dataset.wm;
        b.onload = () => b.closest(".wortmarke").classList.add("hat-bild");
      }
    </script>
    {/* Die Vitas werden genannt, nicht verschwiegen: Sie fehlen im Feld,
        weil sie ein Register sind — nicht, weil es sie nicht gäbe. */}
    <p class="start__satz">
      {`${inhaltlich.length} Notes, gelesen und verbunden seit ${monatJahr(erstesDatum)} — dazu `}
      <a href="/DenkerVita">{vitaZahl} Vitas</a>{" der Menschen dahinter."}
    </p>
  </header>

  {/* ── Die Leiste: filtern und die Ansicht wählen ── */}
  <div class="lenkung" id="lenkung">
    {/* Das Sieb — ein Feld über den Rubriken (27.09.2026, Andreas). Es
        filtert die Karten beim Tippen; die Eingabetaste führt in den
        Volltext. Vorher gab es nur die Suchschicht, und die fand bei
        einem Tippfehler im Namen nicht nichts, sondern Falsches. */}
    <div class="sieb" id="sieb">
      <label class="sieb__feld">
        <svg class="sieb__lupe" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="7" cy="7" r="4.6" fill="none" stroke="currentColor" stroke-width="1.4"/>
          <path d="M10.4 10.4 L14 14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
        <input id="siebFeld" type="search" autocomplete="off" spellcheck="false" enterkeyhint="search"
               placeholder="Im Bestand suchen — ein Name, ein Titel, ein Thema …" aria-label="Notes durchsuchen">
        <kbd class="sieb__taste" id="siebTaste" hidden>↵ Volltext</kbd>
      </label>
      {/* Die Auswahl gehört dem, der sie getroffen hat: Sie steht ganz in
          der Adresse — Lesezeichen, Link, Telefon, alles hält sie. */}
      <button class="lenkung__knopf sieb__teilen" id="teilen" type="button" hidden>Teilen</button>
    </div>
    <script type="application/json" id="siebVitas" set:html={JSON.stringify(vitas)}></script>

    {/* Nur auf dem Telefon sichtbar (start.css): sagt, welche Rubrik
        gewählt ist, und zeigt die Chips erst auf Tippen. */}
    <button class="lenkung__klappe" id="klappe" type="button" aria-expanded="false" aria-controls="filter">
      <span class="regal__punkt" id="klappePunkt" hidden></span>
      <b id="klappeWort">Alles</b><i id="klappeZahl">{inhaltlich.length}</i>
      <i class="rubrikwahl__pfeil" aria-hidden="true"></i>
    </button>
    <div class="lenkung__rubriken" id="filter">
      <button class="chip ist-gewaehlt" type="button" data-rubrik="">
        Alles <i>{inhaltlich.length}</i>
      </button>
      {rubriken.map((r) => (
        <button class="chip" type="button" data-rubrik={r.name}>
          <span class={`regal__punkt regal__punkt--${r.name.toLowerCase()}`}></span>
          {r.name} <i>{r.anzahl}</i>
        </button>
      ))}
    </div>

    <div class="lenkung__ansicht">
      {/* Die Themen quer durch alle Rubriken — eine Wortwolke statt des
          Feldes; ein Wort filtert das Feld (16.09.2026). */}
      <button class="lenkung__knopf" id="themenKnopf" type="button"
              aria-pressed="false" aria-controls="wolke">Themen</button>
      {/* Der Zufall gehört zum Stöbern: Wer findet, was er nicht gesucht
          hat, bleibt. Ohne Javascript führt der Link auf die jüngste Note
          statt ins Leere. */}
      <a class="lenkung__knopf" id="wuerfel" href={feld[0].url} title="Irgendeine Note aus der Auswahl">
        Aufs Geratewohl
      </a>
      <button class="lenkung__knopf lenkung__knopf--wechsel" id="ansicht" type="button"
              aria-pressed="false">
        <span class="zeig-im-feld">Einen Faden gehen</span>
        <span class="zeig-im-faden">Zurück ins Feld</span>
      </button>
    </div>
  </div>

  {/* ── Die Themenwolke ── */}
  <section class="wolke" id="wolke" aria-label="Themen" hidden>
    <p class="wolke__satz">{wolke.length} Themen laufen durch den Bestand. Groß steht, was oft vorkommt; die Farbe zeigt, in welcher Rubrik ein Thema am meisten zu Hause ist.</p>
    <ul class="wolke__liste">
      {wolke.map((t) => (
        <li>
          <button type="button" class="wolke__wort" data-thema={t.name}
                  style={`--grad:${t.grad.toFixed(3)};--farbe:var(--r-${t.rubrik.toLowerCase()})`}
                  title={`${t.anzahl} Notes · am meisten in ${t.rubrik}`}>
            <span class="wolke__text">{t.name.replace(/-/g, " ")}</span><i>{t.anzahl}</i>
          </button>
        </li>
      ))}
    </ul>
  </section>

  {/* ── Das Feld ── */}
  <section class="feld" id="feld">

    {/* Steht nur, wenn eine Nachbarschaft aufgeklappt ist. Sagt, wessen
        Nachbarschaft man gerade sieht — sonst wüsste man nach dem Scrollen
        nicht mehr, warum diese acht Karten hier stehen. */}
    <p class="verwandtschaft" id="verwandtschaft" hidden>
      <span class="verwandtschaft__wort">Verwandt mit</span>
      <b id="verwandtschaftTitel"></b>
      <button type="button" id="verwandtZu">Zurück ins Feld</button>
    </p>

    {/* Sagt, nach welchem Thema das Feld gerade gefiltert ist. */}
    <p class="verwandtschaft" id="themenbalken" hidden>
      <span class="verwandtschaft__wort">Thema</span>
      <b id="themenbalkenWort"></b>
      <button type="button" id="themaAndere">Andere Themen</button>
      <button type="button" id="themaAus">Aufheben</button>
    </p>

    {/* Sagt, was das Sieb gefunden hat — und, wenn es einen Tippfehler
        verziehen hat, wonach es wirklich gesucht hat. */}
    <p class="verwandtschaft sieb__balken" id="siebbalken" hidden>
      <span class="verwandtschaft__wort">Gesucht</span>
      <b id="siebWort"></b>
      <span class="sieb__zahl" id="siebZahl"></span>
      <span class="sieb__vitas" id="siebVitaListe"></span>
      <button type="button" id="siebVoll">Im Volltext</button>
      <button type="button" id="siebAus">Aufheben</button>
    </p>


    <ol class="feld__gitter" id="gitter">
      {feld.map((n, i) => (
        <>
        <li class="kachel" data-rubrik={n.rubrik} data-platz={i}
            data-themen={n.tags.filter((t) => inWolke.has(t)).join(" ") || null}
            data-nah={nachbarschaft[i].length ? nachbarschaft[i].join(",") : null}
            data-titel={n.titel}
            data-marken={markenVon(n) || null}
            hidden={i >= ERSTE_LADUNG}>
          <a class="kachel__weg" href={n.url}>
            <span class="kachel__bild">
              <img src={n.vorschau ?? rubrikBild(n.rubrik)} alt=""
                   width="1200" height="500"
                   loading={i < 9 ? "eager" : "lazy"} decoding="async">
            </span>
            <span class="kachel__kennung">
              <span class={`regal__punkt regal__punkt--${n.rubrik.toLowerCase()}`}></span>
              {n.rubrik}
              {n.datum && <em>{kurzDatum(n.datum)}</em>}
            </span>
            <span class="kachel__titel">{n.titel}</span>
          </a>

          {/* Der Teaser steht außerhalb des Wegs, damit ein Klick auf ihn
              aufklappen kann statt zu navigieren. Bei den meisten Notes
              passt er ganz in die fünf Zeilen; wo nicht, merkt das Skript
              es und macht ihn anfassbar. */}
          {n.beschreibung && <p class="kachel__teaser" title="">{n.beschreibung}</p>}

          {/* Die Griffe stehen neben dem Weg, nicht in ihm: Ein Knopf im
              Innern eines Links ist ungültiges HTML, und der Klick ginge
              beiden zugleich zu. Sie bleiben leise sichtbar statt sich zu
              verstecken — wer sie erst durch Hovern findet, findet sie nie. */}
          <div class="griffe">
            <button class="griff" type="button" data-schau={n.url}
                    title={`Den Anfang von „${n.titel}" lesen, ohne die Seite zu verlassen`}>
              <svg viewBox="0 0 16 16" aria-hidden="true" class="griff__zeichen">
                <path d="M8 3.4C5.4 3.4 3.2 5 2 8c1.2 3 3.4 4.6 6 4.6S12.8 11 14 8c-1.2-3-3.4-4.6-6-4.6Z"
                      fill="none" stroke="currentColor" stroke-width="1.2"/>
                <circle cx="8" cy="8" r="1.7" fill="currentColor"/>
              </svg>
              <span class="griff__wort">Vorschau</span>
            </button>
            {wege.has(n.id) && (
              <button class="griff" type="button" data-faden={n.id}
                      title={`Einen Faden weben, der bei „${n.titel}" beginnt`}>
                <svg viewBox="0 0 16 16" aria-hidden="true" class="griff__zeichen">
                  <path d="M2 12 C 5 12, 5 4, 8 4 S 11 12, 14 12" fill="none"
                        stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                </svg>
                <span class="griff__wort">Faden</span>
              </button>
            )}
            {nachbarschaft[i].length > 0 && (
              <button class="griff" type="button" data-nah-auf={i}
                      title={`Zeigen, was mit „${n.titel}" verwandt ist`}>
                <svg viewBox="0 0 16 16" aria-hidden="true" class="griff__zeichen">
                  <circle cx="8" cy="8" r="1.9" fill="currentColor"/>
                  <circle cx="2.6" cy="4" r="1.3" fill="currentColor" opacity=".55"/>
                  <circle cx="13.4" cy="5" r="1.3" fill="currentColor" opacity=".55"/>
                  <circle cx="4" cy="13" r="1.3" fill="currentColor" opacity=".55"/>
                  <circle cx="12.6" cy="12.4" r="1.3" fill="currentColor" opacity=".55"/>
                  <g stroke="currentColor" stroke-width=".9" opacity=".4">
                    <path d="M8 8 L2.6 4M8 8 L13.4 5M8 8 L4 13M8 8 L12.6 12.4"/>
                  </g>
                </svg>
                <span class="griff__wort griff__wort--bleibt">{nachbarschaft[i].length} verwandt</span>
              </button>
            )}
          </div>
        </li>
          {zeileNach.has(i + 1) && (
            <li class="wiederkehr" aria-label={zeileNach.get(i + 1).map((k) => k.art).join(" und ")} data-karten={zeileNach.get(i + 1).length}>
              {zeileNach.get(i + 1).map((k) => (
                <a class="wiederkehr__karte" href={k.note.url}>
                  <span class="wiederkehr__bild">
                    <img src={k.note.vorschau ?? rubrikBild(k.note.rubrik)} alt=""
                         width="1200" height="500" loading="lazy" decoding="async">
                  </span>
                  <span class="wiederkehr__text">
                    <span class="wiederkehr__kennung">
                      <b>{k.art}</b>
                      <span class={`regal__punkt regal__punkt--${k.note.rubrik.toLowerCase()}`}></span>
                      {k.note.rubrik}
                      {k.note.datum && <em>{langDatum(k.note.datum)}</em>}
                    </span>
                    <span class="wiederkehr__titel">{k.note.titel}</span>
                    {k.satz && <span class="wiederkehr__warum">{k.satz}</span>}
                  </span>
                </a>
              ))}
            </li>
          )}
        </>
      ))}
    </ol>

    <p class="feld__fuss">
      <button id="mehr" type="button">Mehr zeigen</button>
      <span id="standAnzeige" class="feld__stand"></span>
    </p>
  </section>

  {/* ── Der Faden ── */}
  <div class="faeden" id="faeden">
    {faeden.map((faden, fi) => (
      <section class="faden" data-faden={fi} hidden={fi > 0}>
        <ol class="faden__weg">
          {faden.map((s, si) => (
            <li
              class={`station${si === 0 ? " station--auftakt" : ""}`}
              data-tiefe={tiefe(s.datum).toFixed(4)}
              data-monat={s.datum ? monatJahr(s.datum) : ""}
            >
              <a class="station__karte" href={s.url}>
                {s.banner && (
                  <img
                    class={`station__bild${s.eigenesBild ? "" : " station__bild--rubrik"}`}
                    src={s.banner}
                    alt=""
                    width="1200" height="500"
                    loading="lazy"
                    decoding="async"
                  >
                )}

                <div class="kennung">
                  <b>{s.rubrik}</b>
                  {s.datum && <><i>·</i>{langDatum(s.datum)}</>}
                </div>

                <h2 class="station__titel">{s.titel}</h2>
                {s.teaser && <p class="station__teaser">{s.teaser}</p>}

                {/* Der Schritt gehört unter den Titel, nicht über die
                    Rubrikzeile: Dort las er sich als Vorspann der Station,
                    die man gerade verlassen hat. Er sagt, warum der Weg
                    *hierher* führt — also steht er bei dem, wohin er führt. */}
                {s.grund && (
                  <p class={`schritt${s.grund.fund ? " schritt--fund" : ""}${s.grund.satz || s.grund.fund ? "" : " schritt--knapp"}`}>
                    {s.grund.fund && <span class="schritt__marke">im Bestand gefunden</span>}
                    {s.grund.wie}
                  </p>
                )}
              </a>
            </li>
          ))}
        </ol>

        <p class="faden__fuss">
          <span>Sieben Stationen, {monatJahr(faden[0].datum)} bis {monatJahr(faden[faden.length - 1].datum)}</span>
        </p>
      </section>
    ))}

    <p class="start__nochmal">
      <button id="nochmal" type="button">Ein anderer Weg</button>
      <span class="start__zaehler"><b id="fadenNr">1</b> von {faeden.length}</span>
    </p>
  </div>

</main>

<script>
  const wurzel = document.documentElement;

  /* ══ Die Zeitleiste des Fadens ══
     Oben heute, unten der März. Beim Scrollen wandert der Zeiger nach
     unten — man sieht, wie weit man sich vom Neuesten entfernt hat.
     Steht vor dem Ansichtsschalter, weil der sie beim Aufschlagen ruft. */
  const rail = document.getElementById("rail");
  // Weiter oben als auf der Note: Dort steht „0:00", hier „Aug 26" — und
  // der Zeiger der ersten Station säße dem Wort sonst im Gesicht.
  const OBEN = 116, UNTEN = 108;
  const yVon = (p) => `calc(${OBEN}px + (100% - ${OBEN + UNTEN}px) * ${p})`;

  let zeiger = null, marken = [], aktiv = null;
  const sichtbarerFaden = () => document.querySelector(".faden:not([hidden])");

  function leisteBauen(faden) {
    if (!faden) return;
    for (const m of marken) m.remove();
    marken = [];
    for (const st of faden.querySelectorAll(".station")) {
      const m = document.createElement("div");
      m.className = "mark";
      m.style.top = yVon(+st.dataset.tiefe);
      m.title = st.dataset.monat;
      m.onclick = () => st.scrollIntoView({ block: "center", behavior: "smooth" });
      rail.appendChild(m);
      marken.push(m);
      st._marke = m;
    }
    if (!zeiger) {
      zeiger = document.createElement("div");
      zeiger.className = "zeiger";
      zeiger.innerHTML = '<span class="zeiger__zeit"></span>';
      rail.appendChild(zeiger);
    }
    aktiv = null;
    verfolgen();
  }

  function verfolgen() {
    if (wurzel.dataset.ansicht !== "faden") return;
    const sichtbar = sichtbarerFaden();
    if (!sichtbar || !zeiger) return;
    const mitte = innerHeight * 0.42;
    let beste = null, dist = Infinity;
    for (const st of sichtbar.querySelectorAll(".station")) {
      const r = st.getBoundingClientRect();
      if (r.top > innerHeight || r.bottom < 0) continue;
      const d = Math.abs(r.top - mitte);
      if (d < dist) { dist = d; beste = st; }
    }
    if (!beste || beste === aktiv) return;
    aktiv?._marke?.classList.remove("ist");
    aktiv = beste;
    beste._marke?.classList.add("ist");
    zeiger.style.top = yVon(+beste.dataset.tiefe);
    zeiger.querySelector(".zeiger__zeit").textContent = beste.dataset.monat;
  }

  addEventListener("scroll", verfolgen, { passive: true });
  addEventListener("resize", verfolgen);

  /* ══ Das Feld ══ */
  const kacheln = [...document.querySelectorAll(".kachel")];
  const mehr = document.getElementById("mehr");
  const stand = document.getElementById("standAnzeige");
  const balken = document.getElementById("verwandtschaft");
  const balkenTitel = document.getElementById("verwandtschaftTitel");
  const wiederkehrZeilen = [...document.querySelectorAll(".wiederkehr")];
  const PORTION = 48;
  let rubrik = "";      // "" heißt: alles
  let thema = "";       // "" heißt: kein Thema gewählt
  const themenVon = kacheln.map((k) => new Set((k.dataset.themen ?? "").split(" ")));
  const themenbalken = document.getElementById("themenbalken");
  let treffer = null;   // Map Platz → Gewicht, solange das Sieb etwas enthält
  const passt = (k, i) => (!rubrik || k.dataset.rubrik === rubrik) && (!thema || themenVon[i].has(thema))
    && (!treffer || treffer.has(i));
  const siebbalken = document.getElementById("siebbalken");
  let gezeigt = PORTION;
  let quelle = null;    // Platznummer der Karte, deren Nachbarschaft steht

  /* Alle Kacheln stehen im Dokument, sichtbar ist ein Ausschnitt. Der
     Filter rechnet darum nichts nach — er blendet um, und das merkt man
     nicht. Dasselbe gilt für die Nachbarschaft: Die verwandten Karten
     sind längst da, sie stehen nur woanders. */
  function auslegen() {
    if (quelle !== null) {
      const nah = new Set(kacheln[quelle].dataset.nah.split(",").map(Number));
      kacheln.forEach((k, i) => {
        k.hidden = !(i === quelle || nah.has(i));
        // Die Quelle zuerst, dann ihre Nachbarn in der Reihenfolge, in der
        // der Stern sie gewichtet hat. `order` ordnet das Raster um, ohne
        // dass eine Karte das Dokument wechseln müsste.
        k.style.order = i === quelle ? -1 : 0;
        k.classList.toggle("kachel--quelle", i === quelle);
      });
      for (const z of wiederkehrZeilen) z.hidden = true;
      themenbalken.hidden = true;
      siebbalken.hidden = true;
      mehr.hidden = true;
      stand.textContent = `${nah.size} verwandt`;
      kappungPruefen();
      return;
    }

    // Die Wiederkehr-Zeilen gehören zum Grundzustand: Wer eine Rubrik
    // wählt, will diese Rubrik sehen, nicht den Blick zurück.
    for (const z of wiederkehrZeilen) z.hidden = !!(rubrik || thema || treffer);
    themenbalken.hidden = !thema;
    if (thema) document.getElementById("themenbalkenWort").textContent = thema.replace(/-/g, " ");

    /* Ohne Sieb stehen die Karten nach Datum, mit Sieb nach Gewicht — was
       im Titel trifft, vor dem, was nur im Teaser vorkommt. Gleich schwere
       behalten ihre Datumsfolge. */
    const reihe = treffer
      ? [...treffer.keys()].sort((a, b) => treffer.get(b) - treffer.get(a) || a - b)
      : kacheln.map((_, i) => i);
    for (const k of kacheln) {
      k.hidden = true;
      k.style.order = "";
      k.classList.remove("kachel--quelle");
    }
    let passend = 0, sichtbar = 0;
    for (const [n, i] of reihe.entries()) {
      if (!passt(kacheln[i], i)) continue;
      passend++;
      if (sichtbar >= gezeigt) continue;
      kacheln[i].hidden = false;
      if (treffer) kacheln[i].style.order = n;
      sichtbar++;
    }
    mehr.hidden = sichtbar >= passend;
    // Zählt, was die Auswahl übriglässt — nicht, wie groß das Regal ist.
    stand.textContent = sichtbar >= passend ? `alle ${passend}` : `${sichtbar} von ${passend}`;
    chipsZaehlen();
    siebZeigen(passend);
    teilenKnopf.hidden = !(rubrik || thema || treffer);
    kappungPruefen();
  }

  /* Die Zahl am Chip sagt, was er aus der *jetzigen* Auswahl machen würde
     — „Denker 3" ist bei einer Suche eine Auskunft, „Denker 119" nur eine
     Wiederholung des Regals. Ohne Suche und Thema steht wieder die Größe. */
  const chips = [...document.querySelectorAll(".chip")];
  for (const c of chips) c._groesse = c.querySelector("i").textContent;
  function chipsZaehlen() {
    const zahl = new Map();
    if (treffer || thema) {
      kacheln.forEach((k, i) => {
        if ((thema && !themenVon[i].has(thema)) || (treffer && !treffer.has(i))) return;
        zahl.set(k.dataset.rubrik, (zahl.get(k.dataset.rubrik) ?? 0) + 1);
        zahl.set("", (zahl.get("") ?? 0) + 1);
      });
    }
    for (const c of chips) {
      const n = treffer || thema ? zahl.get(c.dataset.rubrik) ?? 0 : null;
      c.querySelector("i").textContent = n ?? c._groesse;
      c.classList.toggle("chip--leer", n === 0 && c.dataset.rubrik !== rubrik);
    }
    window.gwEtikett?.();
  }

  /* ── Die Welle ──
     Kein Morphen: Wenn achtundvierzig Karten auf acht zusammengehen, gibt
     es nichts, was ineinander überginge. Was stimmt, ist ein Zurücktreten
     und ein Heraufkommen. Der Versatz läuft in Leserichtung. */
  const RUHIG = matchMedia("(prefers-reduced-motion: reduce)").matches;
  function welle(umbauen) {
    if (RUHIG) { umbauen(); return; }
    const vorher = kacheln.filter((k) => !k.hidden);
    vorher.forEach((k, n) => {
      k.style.setProperty("--takt", `${Math.min(n, 14) * 11}ms`);
      k.classList.add("geht");
    });
    setTimeout(() => {
      for (const k of vorher) { k.classList.remove("geht"); k.style.removeProperty("--takt"); }
      umbauen();
      kacheln.filter((k) => !k.hidden)
        .sort((a, b) => (+a.style.order || 0) - (+b.style.order || 0))
        .forEach((k, n) => {
          k.style.setProperty("--takt", `${Math.min(n, 18) * 32}ms`);
          k.classList.add("kommt");
          k.addEventListener("animationend", () => {
            k.classList.remove("kommt");
            k.style.removeProperty("--takt");
          }, { once: true });
        });
    }, 360);
  }

  function verwandtesZeigen(i) {
    welle(() => {
      quelle = i;
      balkenTitel.textContent = kacheln[i].dataset.titel;
      balken.hidden = false;
      auslegen();
    });
    document.getElementById("feld").scrollIntoView({ block: "start", behavior: "smooth" });
  }

  function zurueckInsFeld() {
    welle(() => { quelle = null; balken.hidden = true; auslegen(); });
  }

  document.getElementById("verwandtZu").addEventListener("click", zurueckInsFeld);

  /* ── Abgeschnittene Teaser anfassbar machen ──
     Bei drei Karten je Zeile passen die meisten „Worum es geht" ganz in
     die fünf Zeilen. Nur die wirklich gekappten bekommen den Zeigefinger
     — bei allen anderen verspräche er etwas, das nicht passiert.
     Muss nach jedem Umblenden neu laufen: Eine versteckte Karte hat kein
     Layout, also auch keine messbare Höhe. */
  function kappungPruefen() {
    for (const t of document.querySelectorAll(".kachel:not([hidden]) .kachel__teaser")) {
      if (t.classList.contains("ist-offen")) continue;
      const gekappt = t.scrollHeight - t.clientHeight > 4;
      t.classList.toggle("ist-gekappt", gekappt);
      t.title = gekappt ? "Ganz anzeigen" : "";
    }
  }

  document.getElementById("gitter").addEventListener("click", (e) => {
    const teaser = e.target.closest(".kachel__teaser");
    if (teaser && (teaser.classList.contains("ist-gekappt") || teaser.classList.contains("ist-offen"))) {
      const auf = teaser.classList.toggle("ist-offen");
      teaser.classList.toggle("ist-gekappt", !auf);
      teaser.title = auf ? "Wieder einklappen" : "Ganz anzeigen";
      return;
    }
    const schauKnopf = e.target.closest("[data-schau]");
    if (schauKnopf) { gwSchau.oeffnen(schauKnopf.dataset.schau); return; }
    const nahKnopf = e.target.closest("[data-nah-auf]");
    if (nahKnopf) { verwandtesZeigen(+nahKnopf.dataset.nahAuf); return; }
    const fadenKnopf = e.target.closest("[data-faden]");
    if (fadenKnopf) fadenAbHier(fadenKnopf.dataset.faden, fadenKnopf);
  });

  document.getElementById("filter").addEventListener("click", (e) => {
    const chip = e.target.closest(".chip");
    if (!chip) return;
    rubrik = chip.dataset.rubrik;
    adresseSetzen("rubrik", rubrik);
    gezeigt = PORTION;
    wolkeZeigen(false);
    for (const c of document.querySelectorAll(".chip")) c.classList.toggle("ist-gewaehlt", c === chip);
    // Eine Rubrik zu wählen heißt, das Feld wieder sehen zu wollen.
    welle(() => { quelle = null; balken.hidden = true; auslegen(); });
    // Steht die Lenkung (großer Schirm, weit unten), zurück an den Anfang
    // des Feldes — sonst stünde man mitten in der neuen Auswahl.
    if (document.body.classList.contains("lenkung-steht")) {
      document.getElementById("feld").scrollIntoView({ block: "start", behavior: "smooth" });
    }
  });

  mehr.addEventListener("click", () => { gezeigt += PORTION; auslegen(); });

  /* ── Auf dem Telefon von selbst nachlegen ──
     Ein Knopf am Ende einer Spalte ist auf dem Schirm mit der Maus ein
     Halt, mit dem Daumen ein Hindernis (13.09., Andreas). Kommt der Knopf
     in Sicht, tut er, was der Klick täte — die Karten stehen ja längst im
     Dokument, es wird nur umgeblendet. Der Knopf bleibt stehen: Wer ohne
     Beobachter unterwegs ist oder ihn erreicht, bevor die Rechnung fertig
     ist, drückt ihn wie bisher. Am Schreibtisch bleibt es beim Klick —
     dort ist das Ende der Seite ein Ort, an dem man ankommen darf. */
  if ("IntersectionObserver" in window && matchMedia("(max-width: 1179px)").matches) {
    new IntersectionObserver((eintraege) => {
      if (!eintraege.some((e) => e.isIntersecting) || mehr.hidden || quelle !== null) return;
      gezeigt += PORTION; auslegen();
    }, { rootMargin: "0px 0px 900px 0px" }).observe(mehr);
  }

  /* ══ Die Themenwolke ══
     Statt des Feldes, nicht darüber: Wer die Themen sehen will, will
     gerade nicht die Karten. Ein Wort filtert das Feld und bringt es
     zurück; die Rubrik-Chips wirken weiter mit. Das Thema steht in der
     Adresse, wie auf den Rubrikseiten. */
  const wolkeEl = document.getElementById("wolke");
  const themenKnopf = document.getElementById("themenKnopf");
  const inDerWolke = new Set([...wolkeEl.querySelectorAll("[data-thema]")].map((b) => b.dataset.thema));

  function wolkeZeigen(auf) {
    if (auf && wurzel.dataset.ansicht === "faden") ansichtSetzen("feld", false);
    wolkeEl.hidden = !auf;
    wurzel.toggleAttribute("data-wolke", auf);
    themenKnopf.setAttribute("aria-pressed", String(auf));
  }

  function themaSetzen(t) {
    adresseSetzen("thema", t);
    welle(() => {
      thema = t; gezeigt = PORTION; quelle = null; balken.hidden = true;
      wolkeZeigen(false);
      auslegen();
    });
    const feldEl = document.getElementById("feld");
    if (feldEl.getBoundingClientRect().top < 0 || !wolkeEl.hidden) {
      feldEl.scrollIntoView({ block: "start", behavior: "smooth" });
    }
  }

  themenKnopf.addEventListener("click", () => {
    const auf = wolkeEl.hidden;
    wolkeZeigen(auf);
    if (auf && wolkeEl.getBoundingClientRect().top < 0) {
      wolkeEl.scrollIntoView({ block: "start", behavior: "smooth" });
    }
  });
  wolkeEl.addEventListener("click", (e) => {
    const wort = e.target.closest("[data-thema]");
    if (wort) themaSetzen(wort.dataset.thema);
  });
  document.getElementById("themaAndere").addEventListener("click", () => {
    wolkeZeigen(true);
    wolkeEl.scrollIntoView({ block: "start", behavior: "smooth" });
  });
  document.getElementById("themaAus").addEventListener("click", () => themaSetzen(""));

  /* ══ Das Sieb ══
     Ein Feld, das die Karten beim Tippen ausdünnt — über Titel, Teaser,
     Tags und die Namen der Menschen, auf deren Vita eine Note verweist.

     Tippfehler verzeiht es, aber nur, wo es muss: Erst wird wörtlich
     gesucht (Wortanfang, bei längeren Wörtern auch mitten im Wort). Nur
     wenn ein Wort *nirgends* vorkommt, darf es unscharf werden — ein oder
     zwei Buchstaben daneben, Dreher mitgezählt. So wird aus „Morrin"
     Morin, aus „Precht" aber nie Brecht, denn Precht gibt es ja. Die
     Volltextsuche (Pagefind) kannte nur den ersten Schritt und fand bei
     „Harrari" nicht nichts, sondern Tsitsi Dangarembga.

     Umlaute zählen nicht: ä, ae und a sind dasselbe, ß ist ss. Groß und
     klein sowieso nicht. */
  const siebFeld = document.getElementById("siebFeld");
  const siebTaste = document.getElementById("siebTaste");
  const siebWort = document.getElementById("siebWort");
  const siebZahl = document.getElementById("siebZahl");
  const siebVitaListe = document.getElementById("siebVitaListe");
  const teilenKnopf = document.getElementById("teilen");
  let gesucht = "";     // was tatsächlich gesucht wurde, nach Korrektur
  let eingabe = "";     // was dasteht

  const glatt = (w) => w.toLowerCase().replace(/ß/g, "ss")
    .normalize("NFD").replace(/\p{M}/gu, "")
    .replace(/ae/g, "a").replace(/oe/g, "o").replace(/ue/g, "u");
  const woerter = (text) => (text.match(/[\p{L}\p{N}]+/gu) ?? [])
    .map((w) => [glatt(w), w]).filter(([g]) => g.length > 1);

  /* Der Wortschatz wird erst gebaut, wenn jemand das Feld anfasst —
     wer nur schaut, zahlt nichts dafür. */
  let karten = null;    // glattes Wort → Map(Platz → Gewicht)
  let kartenForm = null; // glattes Wort → wie es geschrieben stand
  let vitaWort = null;  // glattes Wort → Set(Vita-Nummer)
  let vitaForm = null;
  const vitaListe = JSON.parse(document.getElementById("siebVitas").textContent);

  function wortschatzBauen() {
    if (karten) return;
    karten = new Map(); kartenForm = new Map();
    const nimm = (text, i, gewicht) => {
      for (const [g, w] of woerter(text ?? "")) {
        if (!kartenForm.has(g)) kartenForm.set(g, w);
        const m = karten.get(g) ?? karten.set(g, new Map()).get(g);
        if ((m.get(i) ?? 0) < gewicht) m.set(i, gewicht);
      }
    };
    kacheln.forEach((k, i) => {
      nimm(k.dataset.titel, i, 3);
      nimm(k.dataset.marken, i, 2);
      nimm(k.querySelector(".kachel__teaser")?.textContent, i, 1);
    });
    vitaWort = new Map(); vitaForm = new Map();
    vitaListe.forEach((v, n) => {
      for (const [g, w] of woerter(v.n)) {
        if (!vitaForm.has(g)) vitaForm.set(g, w);
        (vitaWort.get(g) ?? vitaWort.set(g, new Set()).get(g)).add(n);
      }
    });
  }

  /* Wie nah kommt q an einen Anfang von t heran? Editierdistanz mit
     Drehern, aber gegen jedes Präfix von t — wer „Harar" tippt, ist auf
     dem Weg zu Harari, nicht daneben. Bricht ab, sobald k überschritten
     ist; darum kostet das auch über zwanzigtausend Wörter nichts. */
  function naehe(q, t, k) {
    const m = q.length, n = Math.min(t.length, m + k);
    let vor = null, zeile = Array.from({ length: n + 1 }, (_, j) => j);
    for (let i = 1; i <= m; i++) {
      const neu = [i];
      let kleinste = i;
      for (let j = 1; j <= n; j++) {
        let d = Math.min(zeile[j] + 1, neu[j - 1] + 1, zeile[j - 1] + (q[i - 1] === t[j - 1] ? 0 : 1));
        if (i > 1 && j > 1 && q[i - 1] === t[j - 2] && q[i - 2] === t[j - 1]) d = Math.min(d, vor[j - 2] + 1);
        neu[j] = d;
        if (d < kleinste) kleinste = d;
      }
      if (kleinste > k) return Infinity;
      vor = zeile; zeile = neu;
    }
    return Math.min(...zeile.slice(Math.max(0, m - k)));
  }

  /* Welche Wörter des Wortschatzes ein Suchwort meint, und wie gut. */
  function gemeint(q, formen) {
    const gefunden = new Map();
    for (const t of formen.keys()) {
      if (t === q) gefunden.set(t, 1);
      // Ein kurzes Wort ist oft nur der Anfang eines anderen („los" in
      // „löscht") — es darf treffen, aber leiser.
      else if (t.startsWith(q)) gefunden.set(t, q.length > 3 ? .85 : .4);
      else if (q.length >= 5 && t.includes(q)) gefunden.set(t, .6);
    }
    if (gefunden.size) return { gefunden, statt: null };
    /* Unscharf zählt nur, was am nächsten liegt: Ist „Harari" einen
       Buchstaben entfernt, bleibt „Harare" mit zweien draußen. */
    const k = q.length >= 7 ? 2 : q.length >= 4 ? 1 : 0;
    const nah = new Map();
    let bestes = null, bestesD = Infinity;
    if (k) for (const t of formen.keys()) {
      if (t.length < q.length - k) continue;
      const d = naehe(q, t, k);
      if (d > k || d > bestesD) continue;
      if (d < bestesD) { nah.clear(); bestesD = d; bestes = t; }
      else if (t.length < bestes.length) bestes = t;
      nah.set(t, .5);
    }
    return { gefunden: nah, statt: bestes && formen.get(bestes) };
  }

  function sieben(text) {
    eingabe = text;
    const suchwoerter = woerter(text);
    if (!suchwoerter.length) { treffer = null; gesucht = ""; return []; }
    wortschatzBauen();

    let summe = null;
    const korrigiert = [];
    for (const [q, roh] of suchwoerter) {
      const { gefunden, statt } = gemeint(q, kartenForm);
      korrigiert.push(statt ?? roh);
      const hier = new Map();
      for (const [t, guete] of gefunden) {
        for (const [i, gewicht] of karten.get(t)) {
          const w = guete * gewicht;
          if ((hier.get(i) ?? 0) < w) hier.set(i, w);
        }
      }
      // Jedes Wort muss treffen — mehrere schränken ein.
      if (!summe) summe = hier;
      else for (const [i, w] of summe) hier.has(i) ? summe.set(i, w + hier.get(i)) : summe.delete(i);
    }
    treffer = summe;
    gesucht = korrigiert.join(" ");

    // Die Vitas: gleiche Regeln, eigene Liste.
    let vitas = null;
    for (const [q] of suchwoerter) {
      const { gefunden } = gemeint(q, vitaForm);
      const hier = new Set([...gefunden.keys()].flatMap((t) => [...vitaWort.get(t)]));
      vitas = vitas ? new Set([...vitas].filter((n) => hier.has(n))) : hier;
    }
    return [...vitas].slice(0, 3).map((n) => vitaListe[n]);
  }

  let gefundeneVitas = [];
  function siebZeigen(passend) {
    siebbalken.hidden = !treffer;
    siebTaste.hidden = !treffer;
    if (!treffer) return;
    const anders = glatt(gesucht) !== glatt(eingabe.trim());
    siebWort.textContent = `„${gesucht}"`;
    const ohneFilter = treffer.size;
    const imText = [...ausText].filter((i) => passt(kacheln[i], i)).length;
    siebZahl.textContent = passend
      ? `${passend} ${passend === 1 ? "Note" : "Notes"}${imText ? ` · ${imText === passend ? "alle" : `${imText} davon`} nur im Text` : ""}${anders ? ` · statt „${eingabe.trim()}"` : ""}`
      : ohneFilter
        ? `hier keine · ${ohneFilter} ohne ${rubrik && thema ? "Rubrik und Thema" : rubrik ? "Rubrik" : "Thema"}`
        : "keine Note im Feld";
    siebVitaListe.replaceChildren(...gefundeneVitas.map((v) => {
      const a = document.createElement("a");
      a.className = "sieb__vita";
      a.href = v.u;
      a.innerHTML = `<i>Vita</i> ${v.n.replace(/[<&]/g, (c) => c === "<" ? "&lt;" : "&amp;")}`;
      return a;
    }));
  }

  function siebSetzen(text) {
    gefundeneVitas = sieben(text);
    adresseSetzen("q", text.trim());
    gezeigt = PORTION;
    if (quelle !== null) { quelle = null; balken.hidden = true; }
    auslegen();
    imVolltext(gesucht);
  }

  /* ── Die zweite Tiefe: der Volltext ──
     Titel, Teaser und Tags sagen, *worum* es in einer Note geht. Dass
     Nussbaum in der Arendt-Vita vorkommt oder Žižek bei Finkelde, steht
     nur im Text. Also fragt das Sieb nach jedem Wort still auch Pagefind
     — mit dem Wort, das es verstanden hat, nicht mit dem Tippfehler — und
     stellt, was dort auftaucht, als Karten *hinter* die eigenen Treffer.
     Der Index kommt erst mit dem ersten Wort; wer nur schaut, lädt nichts. */
  let pagefind = null, pfLauf = 0, platzVon = null;
  const ausText = new Set();
  const pfad = (u) => decodeURI(new URL(u, location.origin).pathname)
    .replace(/\/index\.html$|\.html$/, "").replace(/\/$/, "") || "/";

  /* Geladen wird beim ersten Antippen des Feldes, nicht beim ersten Wort:
     Über das Netz braucht der Index eine Sekunde, und die soll vergangen
     sein, bevor jemand zu Ende getippt hat. */
  let volltextBereit = null;
  function volltextLaden() {
    volltextBereit ??= (async () => {
      const pf = "/pagefind/pagefind.js";
      pagefind = await import(/* @vite-ignore */ pf);
      await pagefind.options({ excerptLength: 26 });   // dieselben wie suche.js
      await pagefind.init();
    })().catch((e) => { volltextBereit = null; throw e; });
    return volltextBereit;
  }

  async function imVolltext(begriff) {
    const lauf = ++pfLauf;
    ausText.clear();
    if (!treffer || begriff.trim().length < 3) return;
    try {
      await volltextLaden();
      const antwort = await pagefind.search(begriff);
      if (lauf !== pfLauf || !treffer) return;
      // Nur die ersten vierzig: Jeder Treffer ist ein eigenes kleines
      // Stück, das geladen werden will, und hinter vierzig liest keiner.
      const daten = await Promise.all(antwort.results.slice(0, 40).map((r) => r.data()));
      if (lauf !== pfLauf || !treffer) return;
      platzVon ??= new Map(kacheln.map((k, i) => [pfad(k.querySelector("a").href), i]));
      for (const d of daten) {
        const i = platzVon.get(pfad(d.url));
        if (i === undefined || treffer.has(i)) continue;
        treffer.set(i, .2);   // leichter als jeder eigene Treffer
        ausText.add(i);
      }
      if (ausText.size) auslegen();
    } catch {
      /* Unter `astro dev` gibt es keinen Index — dann bleibt es beim Sieb. */
    }
  }

  let siebWarten = null;
  siebFeld.addEventListener("focus", () => {
    wortschatzBauen();
    volltextLaden().catch(() => {});
  }, { once: true });
  siebFeld.addEventListener("input", () => {
    // Wer tippt, will das Feld sehen — nicht den Faden, nicht die Wolke.
    if (wurzel.dataset.ansicht === "faden") ansichtSetzen("feld", false);
    if (!wolkeEl.hidden) wolkeZeigen(false);
    clearTimeout(siebWarten);
    siebWarten = setTimeout(() => siebSetzen(siebFeld.value), 110);
  });

  /* Die Eingabetaste führt eine Tiefe weiter: in den Volltext, mit dem
     Wort, das das Sieb verstanden hat, nicht mit dem Tippfehler. */
  const TASTATUR_WEG = matchMedia("(pointer: coarse)").matches;
  if (matchMedia("(max-width: 700px)").matches) siebFeld.placeholder = "Ein Name, ein Titel, ein Thema …";
  const volltext = () => window.gwSuche?.oeffnen(gesucht || siebFeld.value.trim());
  siebFeld.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault(); clearTimeout(siebWarten); siebSetzen(siebFeld.value);
      // Auf dem Telefon heißt die Taste „Suchen" und soll die Tastatur
      // schließen, damit man die Karten sieht — keine zweite Schicht öffnen.
      TASTATUR_WEG ? siebFeld.blur() : volltext();
    }
    if (e.key === "Escape" && siebFeld.value) { e.preventDefault(); siebFeld.value = ""; siebSetzen(""); }
  });
  document.getElementById("siebVoll").addEventListener("click", volltext);
  document.getElementById("siebAus").addEventListener("click", () => {
    siebFeld.value = "";
    welle(() => siebSetzen(""));
  });

  /* Die Suche in der Kopfleiste (und ⌘K) führt hier ins Sieb statt in
     die Schicht darüber — zwei Felder auf einer Seite hießen, erst
     entscheiden zu müssen, in welches man tippt. Im Faden gilt das nicht:
     Dort steht kein Feld, also bleibt es bei der Schicht. */
  window.gwSieb = () => {
    if (wurzel.dataset.ansicht === "faden") return false;
    const oben = document.getElementById("lenkung").getBoundingClientRect().top;
    if (oben < 0 || oben > innerHeight * .6) document.getElementById("lenkung").scrollIntoView({ block: "start", behavior: "smooth" });
    siebFeld.focus({ preventScroll: true });
    siebFeld.select();
    return true;
  };

  /* ── Das Sieb zieht in die Kopfleiste ──
     Wie die Wortmarke: Steht die Lenkung (großer Schirm, weit unten), bettet
     sich das Feld in die Kopfleiste ein — in seiner Breite, zwischen Marke
     und Werkzeug. Schmaler wird es nur, wenn das Fenster den Platz nicht
     hergibt (27.09., Andreas). Eine ganze Zeile Lesefläche mehr.

     Umgehängt statt verschoben: Die Lenkung ist eine eigene Ebene unter der
     Kopfleiste, ein Kind von ihr käme dort nicht hin, wie hoch man es auch
     stapelt. Damit beim Umhängen nichts springt, bekommt die Lenkung genau
     die Höhe als Abstand darunter, die sie verliert — der Fluss der Seite
     bleibt, nur der verdeckende Kasten wird kleiner. Und weil sich dabei
     ihre Oberkante nicht bewegt, kann das Andocken nicht hin- und herkippen. */
  {
    const sieb = document.getElementById("sieb");
    const lenkungEl = document.getElementById("lenkung");
    const weg = document.querySelector(".kopfleiste__weg");
    let oben = false;

    const umhaengen = (hinauf) => {
      if (hinauf === oben || !weg) return;
      const aktiv = document.activeElement === siebFeld;
      const [von, bis] = [siebFeld.selectionStart, siebFeld.selectionEnd];
      const vorher = lenkungEl.offsetHeight;
      // So breit wie unten, nie breiter — das Fenster darf es schmaler machen.
      if (hinauf) document.documentElement.style.setProperty("--sieb-breite", `${sieb.offsetWidth}px`);
      if (hinauf) weg.after(sieb);
      else lenkungEl.prepend(sieb);
      lenkungEl.style.marginBottom = hinauf ? `calc(2.4rem + ${vorher - lenkungEl.offsetHeight}px)` : "";
      sieb.classList.toggle("sieb--oben", hinauf);
      if (aktiv) { siebFeld.focus({ preventScroll: true }); siebFeld.setSelectionRange(von, bis); }
      oben = hinauf;
    };
    // leser.js entscheidet, ob die Lenkung steht — hier wird nur zugehört.
    new MutationObserver(() => umhaengen(document.body.classList.contains("lenkung-steht")))
      .observe(document.body, { attributes: true, attributeFilter: ["class"] });
    umhaengen(document.body.classList.contains("lenkung-steht"));
  }

  /* ══ Die Auswahl in der Adresse ══
     Rubrik, Thema und Sieb stehen in der Adresse — das ist das eigentliche
     Speichern. Ein Lesezeichen hält es, ein Link trägt es weiter, auf dem
     Telefon geht es auf wie am Schreibtisch. */
  function adresseSetzen(name, wert) {
    const adresse = new URL(location.href);
    wert ? adresse.searchParams.set(name, wert) : adresse.searchParams.delete(name);
    history.replaceState(null, "", adresse.pathname + adresse.search);
  }

  const MAC = /Mac|iPhone|iPad/.test(navigator.platform);
  teilenKnopf.addEventListener("click", async () => {
    const was = [eingabe.trim() && `„${gesucht || eingabe.trim()}"`, rubrik, thema && thema.replace(/-/g, " ")]
      .filter(Boolean).join(" · ");
    const titel = `Gedankenwelten — ${was}`;
    // Das Teilen-Blatt des Telefons kennt „Lesezeichen", „Nachricht",
    // „Notizen" — es kann mehr als wir. Am Schreibtisch reicht der Link.
    if (navigator.share && matchMedia("(pointer: coarse)").matches) {
      try { await navigator.share({ title: titel, url: location.href }); } catch {}
      return;
    }
    try {
      await navigator.clipboard.writeText(location.href);
      teilenKnopf.textContent = `Link kopiert · ${MAC ? "⌘D" : "Strg+D"} fürs Lesezeichen`;
    } catch {
      teilenKnopf.textContent = `${MAC ? "⌘D" : "Strg+D"} fürs Lesezeichen`;
    }
    clearTimeout(teilenKnopf._zurueck);
    teilenKnopf._zurueck = setTimeout(() => { teilenKnopf.textContent = "Teilen"; }, 3200);
  });

  /* ══ Den Platz im Feld behalten ══
     Wer sich durch dreihundert Karten gescrollt hat, eine Note öffnet und
     zurückkommt, soll dort stehen, wo er war — und nicht wieder oben.

     Das ist nicht nur Bequemlichkeit: Ohne das taugt auch der
     Browser-Zurück-Knopf nichts. Er stellt die Scrollhöhe wieder her, aber
     das Feld baut sich mit achtundvierzig Karten neu auf — die Höhe zeigt
     dann irgendwohin. Also merken wir uns den *Zustand* und stellen die
     Höhe selbst wieder ein.

     Im sessionStorage, nicht im localStorage: Der Platz gehört zu diesem
     Besuch. Morgen fängt man neu an. */
  const PLATZ = "gw-feld";

  function platzSichern() {
    try {
      sessionStorage.setItem(PLATZ, JSON.stringify({ rubrik, thema, q: eingabe, gezeigt, quelle, y: Math.round(scrollY) }));
    } catch {}
  }
  // `pagehide` und nicht `beforeunload`: Letzteres verhindert, dass die
  // Seite in den Zurück-Zwischenspeicher darf.
  addEventListener("pagehide", platzSichern);

  let zurueckAuf = null;
  try {
    const p = JSON.parse(sessionStorage.getItem(PLATZ) || "null");
    if (p) {
      rubrik = p.rubrik ?? "";
      thema = p.thema ?? "";
      if (p.q) { siebFeld.value = p.q; gefundeneVitas = sieben(p.q); }
      gezeigt = Math.max(PORTION, p.gezeigt ?? PORTION);
      quelle = Number.isInteger(p.quelle) ? p.quelle : null;
      zurueckAuf = p.y || 0;
      if (quelle !== null && kacheln[quelle]?.dataset.nah) {
        balkenTitel.textContent = kacheln[quelle].dataset.titel;
        balken.hidden = false;
      } else {
        quelle = null;
      }
    }
  } catch {}

  /* Was in der Adresse steht, gilt vor dem gemerkten Platz — wer einen
     Link mit ?thema=, ?rubrik= oder ?q= bekommt, will genau das sehen.
     Und umgekehrt: Steht dort nichts, schreibt der gemerkte Platz sich
     hinein, damit auch ein zurückgekehrter Blick teilbar ist. */
  {
    const p = new URL(location.href).searchParams;
    const t = p.get("thema"), r = p.get("rubrik"), q = p.get("q");
    const vonAussen = (t && inDerWolke.has(t)) || r !== null || q !== null;
    if (vonAussen) {
      thema = t && inDerWolke.has(t) ? t : "";
      rubrik = r && document.querySelector(`.chip[data-rubrik="${CSS.escape(r)}"]`) ? r : "";
      siebFeld.value = q ?? "";
      gefundeneVitas = sieben(q ?? "");
      quelle = null; balken.hidden = true; zurueckAuf = null; gezeigt = PORTION;
    }
    adresseSetzen("rubrik", rubrik);
    adresseSetzen("thema", thema);
    adresseSetzen("q", eingabe.trim());
    for (const c of document.querySelectorAll(".chip")) {
      c.classList.toggle("ist-gewaehlt", c.dataset.rubrik === rubrik);
    }
  }

  auslegen();
  if (treffer) imVolltext(gesucht);
  kappungPruefen();
  addEventListener("resize", kappungPruefen);

  /* Die Höhe erst, wenn die Karten stehen. Sie brauchen ihre Bilder nicht
     abzuwarten — `width`/`height` an jedem `img` halten den Platz frei,
     das Layout steht also schon vor dem ersten Byte Bild. */
  if (zurueckAuf) {
    history.scrollRestoration = "manual";   // sonst zöge der Browser dagegen
    scrollTo({ top: zurueckAuf, behavior: "instant" });
  }

  /* ══ Die Vorschau ══ steht in leser.js (`gwSchau`) — Startseite und
     Note teilen sie sich seit dem 05.09. */

  /* Aufs Geratewohl — aus dem, was gerade gefiltert ist. Sonst führte der
     Würfel aus einer Rubrik hinaus, die man ausdrücklich gewählt hat. */
  document.getElementById("wuerfel").addEventListener("click", (e) => {
    e.preventDefault();
    const topf = kacheln.filter(passt);
    location.href = topf[Math.floor(Math.random() * topf.length)].querySelector("a").href;
  });

  /* ── Ein anderer Weg ──
     Neun Fäden liegen fertig im Dokument, einer je Rubrik als Eingang.
     Sie im Browser neu zu berechnen hieße, den halben Bestand mitzuliefern
     — für eine Geste, die neun Zustände hat. */
  const alleFadenTeile = [...document.querySelectorAll(".faden")];
  const nr = document.getElementById("fadenNr");
  let i = 0;
  document.getElementById("nochmal")?.addEventListener("click", () => {
    alleFadenTeile[i].hidden = true;
    i = (i + 1) % alleFadenTeile.length;
    alleFadenTeile[i].hidden = false;
    nr.textContent = String(i + 1);
    leisteBauen(alleFadenTeile[i]);
    alleFadenTeile[i].scrollIntoView({ block: "start", behavior: "smooth" });
  });

  /* ══ Ein Faden ab dieser Karte ══
     Die neun fertigen Wege beginnen bei der jüngsten Note jeder Rubrik.
     Wer bei einer bestimmten anfangen will, bekommt seinen eigenen — die
     Wege für alle Notes liegen in `faeden.json` und werden beim ersten
     Klick geholt, nicht beim Laden der Seite. */
  const MONATE = ["Januar","Februar","März","April","Mai","Juni","Juli",
                  "August","September","Oktober","November","Dezember"];
  const monatJahr = (d) => { const [j, m] = d.split("-"); return `${MONATE[+m - 1]} ${j}`; };
  const langDatum = (d) => {
    if (!d) return null;
    const [j, m, t] = d.split("-");
    return `${+t}. ${MONATE[+m - 1]} ${j}`;
  };
  const VON = Date.parse(rail.dataset.von), BIS = Date.parse(rail.dataset.bis);
  const tiefe = (d) => (d ? (BIS - Date.parse(d)) / (BIS - VON || 1) : 0);

  let wegeDaten = null;
  const nochmalBlock = document.getElementById("nochmal").parentElement;

  async function fadenAbHier(id, knopf) {
    if (!wegeDaten) {
      knopf?.classList.add("griff--laedt");
      try {
        wegeDaten = await (await fetch("/faeden.json")).json();
      } catch {
        // Ehrlich sagen, dass es nicht ging, statt stumm nichts zu tun.
        knopf?.classList.remove("griff--laedt");
        if (knopf) knopf.lastChild.textContent = " nicht erreichbar";
        return;
      }
      knopf?.classList.remove("griff--laedt");
    }
    const weg = wegeDaten.f[id];
    if (!weg) return;

    // Die neun stehenden Wege treten beiseite, der eigene tritt an ihre
    // Stelle — und mit ihnen der Zähler, der nur für sie gilt.
    for (const f of alleFadenTeile) f.hidden = true;
    nochmalBlock.hidden = true;
    document.getElementById("eigenerFaden")?.remove();

    const teil = document.createElement("section");
    teil.className = "faden";
    teil.id = "eigenerFaden";
    teil.innerHTML = `<ol class="faden__weg">${weg.map(([nr, grund, fund], s) => {
      const n = wegeDaten.n[nr];
      const bild = n.b
        ? `<img class="station__bild${n.e ? "" : " station__bild--rubrik"}" src="${n.b}"
                alt="" width="1200" height="500" loading="lazy" decoding="async">` : "";
      const schritt = grund
        ? `<p class="schritt${fund ? " schritt--fund" : ""}">${
             fund ? '<span class="schritt__marke">im Bestand gefunden</span>' : ""}${grund}</p>`
        : "";
      return `<li class="station${s === 0 ? " station--auftakt" : ""}"
                  data-tiefe="${tiefe(n.d).toFixed(4)}" data-monat="${n.d ? monatJahr(n.d) : ""}">
        <a class="station__karte" href="${n.u}">${bild}
          <div class="kennung"><b>${n.r}</b>${n.d ? `<i>·</i>${langDatum(n.d)}` : ""}</div>
          <h2 class="station__titel">${n.t}</h2>
          ${n.x ? `<p class="station__teaser">${n.x}</p>` : ""}
          ${schritt}
        </a></li>`;
    }).join("")}</ol>
    <p class="faden__fuss"><span>${weg.length} Stationen ab dieser Note</span></p>`;

    document.getElementById("faeden").prepend(teil);
    ansichtSetzen("faden", false);   // nicht merken: das war ein Ausflug, keine Wahl
    scrollTo({ top: 0, behavior: "smooth" });
    leisteBauen(teil);
  }

  /* ══ Von einer Note aus ══
     Der Knopf am Fuß jeder Note führt hierher mit `?faden=<Kennung>`:
     Wer eine Note über die Suche gefunden hat, soll von dort weitergehen
     können, nicht erst über eine Karte im Feld (13.09., Andreas). Der
     Parameter wird nach dem Start aus der Adresse genommen — ein Neuladen
     zeigt das Feld, nicht denselben Ausflug noch einmal. */
  {
    const gewuenscht = new URL(location.href).searchParams.get("faden");
    if (gewuenscht) {
      history.replaceState(null, "", location.pathname);
      fadenAbHier(gewuenscht, null);
    }
  }

  /* ══ Ansicht: Feld oder Faden ══
     Der Grundzustand ist das Feld. Wer den Faden wählt, bekommt ihn beim
     nächsten Besuch wieder — die Wahl gehört dem Leser, nicht der Seite.
     Steht am Ende, weil das Aufräumen alles kennen muss, was oben entsteht. */
  const ansichtKnopf = document.getElementById("ansicht");

  function ansichtSetzen(a, merken) {
    wurzel.dataset.ansicht = a;
    if (a === "faden" && !wolkeEl.hidden) wolkeZeigen(false);
    ansichtKnopf.setAttribute("aria-pressed", String(a === "faden"));
    if (merken) { try { localStorage.setItem("gw-ansicht", a); } catch {} }
    if (a === "faden") {
      leisteBauen(sichtbarerFaden());
    } else {
      // Ein eigener Faden gehört zu dem Klick, der ihn gewebt hat. Bliebe
      // er liegen, fände man beim nächsten Aufschlagen einen Weg vor, den
      // man nicht mehr angefordert hat.
      document.getElementById("eigenerFaden")?.remove();
      nochmalBlock.hidden = false;
      alleFadenTeile.forEach((f, n) => { f.hidden = n !== i; });
    }
  }

  // Der Kopf hat den gespeicherten Zustand schon gesetzt; hier wird der
  // Knopf nur noch darauf eingestellt.
  if (wurzel.dataset.ansicht === "faden") ansichtSetzen("faden", false);

  ansichtKnopf.addEventListener("click", () => {
    ansichtSetzen(wurzel.dataset.ansicht === "faden" ? "feld" : "faden", true);
    scrollTo({ top: 0, behavior: "smooth" });
  });
</script>

