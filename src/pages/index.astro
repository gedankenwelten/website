---
import { BUILD } from "../lib/site.mjs";
/**
 * Die Startseite — zwei Zugänge, einer davon der Grundzustand.
 *
 * Sie war zuerst nur ein Weg: sieben Stationen, an geschriebenen
 * Verbindungen entlang rückwärts durch die Zeit. Als Idee gut, als
 * Startseite falsch — sie beginnt mit *einer* Note groß, und das liest
 * sich als Behauptung, dass ausgerechnet diese wichtig sei. Wer ankommt,
 * will erst sehen, was da ist.
 *
 * Also: **Das Feld ist der Grundzustand** — alle Notes als Karten, nach
 * Datum, nach Rubrik filterbar. Das ist der journalistische Teil:
 * Übersicht, Gleichrang, selbst entscheiden. **Der Faden bleibt als
 * Angebot** hinter einem Knopf. Das ist der kuratierte Teil: eine
 * Strecke, eine Handschrift. Was einer lieber mag, merkt sich der Browser.
 */
import "../styles/note.css";
import "../styles/stern.css";
import "../styles/start.css";
import { alleFaeden, alleWege } from "../lib/faden.mjs";
import { ladeIndex, rubrikBild } from "../lib/notizen.mjs";
import { ladeGraph, sternFuer } from "../lib/graph.mjs";
import { alleRubriken } from "../lib/rubriken.mjs";
import { wiederkehrDieserWoche, gefundenDieserWoche } from "../lib/wiederkehr.mjs";
import Suche from "../components/Suche.astro";
import Kopfleiste from "../components/Kopfleiste.astro";
import Kopf from "../components/Kopf.astro";
import Fusszeile from "../components/Fusszeile.astro";
import Schau from "../components/Schau.astro";
import "../styles/mobil.css";

const faeden = alleFaeden(7);
const idx = ladeIndex();
const g = ladeGraph();

/* Ohne die Kataloge und ohne die beiden alten Quartz-Deckblätter
   (`Zeitgeist/index`, `GoodNews/index`) — sonst zählte das Feld einen
   Bestand, den die Rubrikseite daneben anders zählt. */
const notes = idx.alle.filter((n) => !g.katalog.has(n.id) && n.basis.toLowerCase() !== "index");
const datiert = notes.map((n) => n.datum).filter(Boolean).sort();
const [erstesDatum, letztesDatum] = [datiert[0], datiert[datiert.length - 1]];

/* Das Feld zeigt, was gedacht wurde — nicht, wer gedacht hat.
   Die 269 DenkerVitas sind ein Register: Herkunft, Werk, Kernthesen zu
   einer Person. Als Karte neben einer Note stehen sie im falschen Rang,
   und sie sind ein gutes Drittel des Bestands — sie würden das Feld
   fluten. Erreichbar bleiben sie über die Rubrikwahl im Kopf, über die
   Suche und über jede Note, die auf ihren Menschen verweist. */
const OHNE_IM_FELD = new Set(["DenkerVita"]);
const inhaltlich = notes.filter((n) => !OHNE_IM_FELD.has(n.rubrik));
const vitaZahl = notes.length - inhaltlich.length;

const rubriken = alleRubriken().filter((r) => !OHNE_IM_FELD.has(r.name));

/* Neueste zuerst. Notes ohne Datum ganz nach hinten — sie sind nicht
   neu, sie sind nur undatiert. */
const feld = [...inhaltlich].sort((a, b) =>
  String(b.datum ?? "").localeCompare(String(a.datum ?? "")));

/* ── Die Nachbarschaft jeder Karte ──
   Für das Aufklappen an Ort und Stelle: Welche Karten treten hervor, wenn
   man bei einer „Verwandtes" drückt. Als *Platznummern*, nicht als
   Kennungen — die Karten stehen ja schon alle im Dokument, es geht nur
   darum, welche gemeint sind. Fünfhundert Ziffernlisten wiegen ein paar
   Kilobyte; dieselben Verweise als Pfade wären das Zehnfache.

   Nachbarn aus dem Register (DenkerVita) fallen weg: Sie haben im Feld
   keine Karte, auf die man zeigen könnte. Wer den ganzen Stern will,
   findet ihn am Fuß der Note. */
/* Welche Karte überhaupt einen Faden anbieten kann. `alleWege` rechnet
   das einmal für den ganzen Bestand; `faeden.json` daneben greift auf
   denselben Speicher zu, statt fünfhundert Wege ein zweites Mal zu suchen. */
const wege = alleWege(7);

/* Die Wiederkehr: eine Note aus dem Pool, jede Woche eine andere — mit
   ihrem echten Datum, deshalb ohne jede Konkurrenz zum Feld darunter.
   Wer den Pool pflegen will: `Wiederkehr.md` im Vault. */
const wiederkehr = wiederkehrDieserWoche();
/* Und daneben, was gelesen wird: die Note, zu der die Suche die Leser in
   den letzten dreißig Tagen gebracht hat — älter als zwei Wochen, sonst
   stünde sie doppelt. Nie mehr als diese zwei Karten: Das Neue darunter
   soll nicht ins Nirwana. */
const gefunden = gefundenDieserWoche(new Date(), new Set(wiederkehr ? [wiederkehr.note.id] : []));
const vorn = [
  wiederkehr && { art: "Wiedergelesen", note: wiederkehr.note, satz: wiederkehr.warum ?? wiederkehr.note.beschreibung },
  gefunden && { art: "Gefunden", note: gefunden.note, satz: gefunden.note.beschreibung },
].filter(Boolean);

const platz = new Map(feld.map((n, i) => [n.id, i]));
const nachbarschaft = feld.map((n) => {
  const stern = sternFuer(n.id, 14);
  if (!stern) return [];
  return stern.nodes
    .filter((k) => !k.mitte)
    .map((k) => platz.get(k.id))
    .filter((i) => i !== undefined);
});

/* Wie viele Karten sichtbar starten. Alle stehen im Dokument — sonst
   könnte der Rubrikfilter nicht sofort antworten, und ein Filter, der
   erst lädt, ist zäher als gar keiner. Sichtbar ist erst dieser Anfang. */
const ERSTE_LADUNG = 48;

/* Die Zeitleiste läuft von heute nach unten in die Vergangenheit — lesen
   heißt hier zurückgehen. Der Anteil sagt, wie weit eine Station liegt. */
const spanne = Date.parse(letztesDatum) - Date.parse(erstesDatum) || 1;
const tiefe = (d) => (d ? (Date.parse(letztesDatum) - Date.parse(d)) / spanne : 0);

const MONATE = ["Januar","Februar","März","April","Mai","Juni","Juli","August","September","Oktober","November","Dezember"];
const langDatum = (d) => {
  if (!d) return null;
  const [j, m, t] = d.split("-");
  return `${Number(t)}. ${MONATE[Number(m) - 1]} ${j}`;
};
const kurzDatum = (d) => {
  if (!d) return null;
  const [j, m, t] = d.split("-");
  return `${Number(t)}.${Number(m)}.${j.slice(2)}`;
};
const monatJahr = (d) => {
  const [j, m] = d.split("-");
  return `${MONATE[Number(m) - 1]} ${j}`;
};
// Die Leiste ist 4,5 rem breit — „September 2026" passt dort nicht hinein.
const kurzMonat = (d) => {
  const [j, m] = d.split("-");
  return `${MONATE[Number(m) - 1].slice(0, 3)} ${j.slice(2)}`;
};
---
<!DOCTYPE html>
<html lang="de" data-theme="hell">
<head>
  <Kopf beschreibung={`Jeder Mensch hat seine eigene Gedankenwelt. ${notes.length} Notes — Zeitgeist, Denker, Geistesblitz, Kultur, Spuren — gelesen, gegengeprüft und verbunden.`} art="website" />
  {/* Die Ansicht muss vor dem ersten Bild feststehen: Stünde sie erst am
      Fuß der Seite, sähe jeder Faden-Leser zuerst das Feld aufblitzen. */}
  <script is:inline>
    try {
      if (localStorage.getItem("gw-ansicht") === "faden")
        document.documentElement.dataset.ansicht = "faden";
    } catch {}
  </script>
</head>
<body class="ist-start">

<Kopfleiste />

{/* Die Zeitleiste gehört zum Faden — sie zeigt, wie weit man sich beim
    Gehen vom Neuesten entfernt hat. Im Feld hätte sie nichts zu sagen. */}
<div class="rail" id="rail" data-von={erstesDatum} data-bis={letztesDatum}>
  <div class="rail__cap rail__cap--oben">{kurzMonat(letztesDatum)}</div>
  <div class="rail__line"></div>
  <div class="rail__cap rail__cap--unten">{kurzMonat(erstesDatum)}</div>
</div>

<main class="start">

  <header class="start__kopf">
    {/* Die gemalte Wortmarke — hier und nur hier, als Auftakt. Sie wechselt
        mit dem Kalendertag (Vorspann setzt `data-wm`) und mit dem Thema
        (`leser.js` tauscht das Bild am selben Knopf). Das Wort darunter
        trägt, bis das Bild da ist, und bleibt stehen, wenn es nie kommt.
        Die Quelle wird erst hier gesetzt, nicht im Markup: Stünde sie dort,
        holte der Browser die Marke des Bautags im hellen Thema, bevor
        irgendwer sie korrigieren kann — zwei Bilder für eine Marke. */}
    <h1 class="wortmarke">
      <span class="wortmarke__wort">Gedanken&shy;welten</span>
      <img class="wortmarke__bild" id="wortmarke" alt="Gedankenwelten" decoding="async">
    </h1>
    <script is:inline>
      {
        const w = document.documentElement, b = document.getElementById("wortmarke");
        b.src = `/wortmarke/wordmark-${w.dataset.wm}-${w.dataset.theme === "dunkel" ? "dark" : "light"}.png`;
        b.dataset.stil = w.dataset.wm;
        b.onload = () => b.closest(".wortmarke").classList.add("hat-bild");
      }
    </script>
    {/* Die Vitas werden genannt, nicht verschwiegen: Sie fehlen im Feld,
        weil sie ein Register sind — nicht, weil es sie nicht gäbe. */}
    <p class="start__satz">
      {`${inhaltlich.length} Notes, gelesen und verbunden seit ${monatJahr(erstesDatum)} — dazu `}
      <a href="/DenkerVita">{vitaZahl} Vitas</a>{" der Menschen dahinter."}
    </p>
  </header>

  {/* ── Die Leiste: filtern und die Ansicht wählen ── */}
  <div class="lenkung" id="lenkung">
    {/* Nur auf dem Telefon sichtbar (start.css): sagt, welche Rubrik
        gewählt ist, und zeigt die Chips erst auf Tippen. */}
    <button class="lenkung__klappe" id="klappe" type="button" aria-expanded="false" aria-controls="filter">
      <span class="regal__punkt" id="klappePunkt" hidden></span>
      <b id="klappeWort">Alles</b><i id="klappeZahl">{inhaltlich.length}</i>
      <i class="rubrikwahl__pfeil" aria-hidden="true"></i>
    </button>
    <div class="lenkung__rubriken" id="filter">
      <button class="chip ist-gewaehlt" type="button" data-rubrik="">
        Alles <i>{inhaltlich.length}</i>
      </button>
      {rubriken.map((r) => (
        <button class="chip" type="button" data-rubrik={r.name}>
          <span class={`regal__punkt regal__punkt--${r.name.toLowerCase()}`}></span>
          {r.name} <i>{r.anzahl}</i>
        </button>
      ))}
    </div>

    <div class="lenkung__ansicht">
      {/* Der Zufall gehört zum Stöbern: Wer findet, was er nicht gesucht
          hat, bleibt. Ohne Javascript führt der Link auf die jüngste Note
          statt ins Leere. */}
      <a class="lenkung__knopf" id="wuerfel" href={feld[0].url} title="Irgendeine Note aus der Auswahl">
        Aufs Geratewohl
      </a>
      <button class="lenkung__knopf lenkung__knopf--wechsel" id="ansicht" type="button"
              aria-pressed="false">
        <span class="zeig-im-feld">Einen Faden gehen</span>
        <span class="zeig-im-faden">Zurück ins Feld</span>
      </button>
    </div>
  </div>

  {/* ── Das Feld ── */}
  <section class="feld" id="feld">

    {/* Steht nur, wenn eine Nachbarschaft aufgeklappt ist. Sagt, wessen
        Nachbarschaft man gerade sieht — sonst wüsste man nach dem Scrollen
        nicht mehr, warum diese acht Karten hier stehen. */}
    <p class="verwandtschaft" id="verwandtschaft" hidden>
      <span class="verwandtschaft__wort">Verwandt mit</span>
      <b id="verwandtschaftTitel"></b>
      <button type="button" id="verwandtZu">Zurück ins Feld</button>
    </p>

    {vorn.length > 0 && (
      <aside class="wiederkehr" aria-label="Wiedergelesen und Gefunden" data-karten={vorn.length}>
        {vorn.map((k) => (
          <a class="wiederkehr__karte" href={k.note.url}>
            <span class="wiederkehr__bild">
              <img src={k.note.vorschau ?? rubrikBild(k.note.rubrik)} alt=""
                   width="1200" height="500" loading="eager" decoding="async">
            </span>
            <span class="wiederkehr__text">
              <span class="wiederkehr__kennung">
                <b>{k.art}</b>
                <span class={`regal__punkt regal__punkt--${k.note.rubrik.toLowerCase()}`}></span>
                {k.note.rubrik}
                {k.note.datum && <em>{langDatum(k.note.datum)}</em>}
              </span>
              <span class="wiederkehr__titel">{k.note.titel}</span>
              {k.satz && <span class="wiederkehr__warum">{k.satz}</span>}
            </span>
          </a>
        ))}
      </aside>
    )}

    <ol class="feld__gitter" id="gitter">
      {feld.map((n, i) => (
        <li class="kachel" data-rubrik={n.rubrik} data-platz={i}
            data-nah={nachbarschaft[i].length ? nachbarschaft[i].join(",") : null}
            data-titel={n.titel}
            hidden={i >= ERSTE_LADUNG}>
          <a class="kachel__weg" href={n.url}>
            <span class="kachel__bild">
              <img src={n.vorschau ?? rubrikBild(n.rubrik)} alt=""
                   width="1200" height="500"
                   loading={i < 9 ? "eager" : "lazy"} decoding="async">
            </span>
            <span class="kachel__kennung">
              <span class={`regal__punkt regal__punkt--${n.rubrik.toLowerCase()}`}></span>
              {n.rubrik}
              {n.datum && <em>{kurzDatum(n.datum)}</em>}
            </span>
            <span class="kachel__titel">{n.titel}</span>
          </a>

          {/* Der Teaser steht außerhalb des Wegs, damit ein Klick auf ihn
              aufklappen kann statt zu navigieren. Bei den meisten Notes
              passt er ganz in die fünf Zeilen; wo nicht, merkt das Skript
              es und macht ihn anfassbar. */}
          {n.beschreibung && <p class="kachel__teaser" title="">{n.beschreibung}</p>}

          {/* Die Griffe stehen neben dem Weg, nicht in ihm: Ein Knopf im
              Innern eines Links ist ungültiges HTML, und der Klick ginge
              beiden zugleich zu. Sie bleiben leise sichtbar statt sich zu
              verstecken — wer sie erst durch Hovern findet, findet sie nie. */}
          <div class="griffe">
            <button class="griff" type="button" data-schau={n.url}
                    title={`Den Anfang von „${n.titel}" lesen, ohne die Seite zu verlassen`}>
              <svg viewBox="0 0 16 16" aria-hidden="true" class="griff__zeichen">
                <path d="M8 3.4C5.4 3.4 3.2 5 2 8c1.2 3 3.4 4.6 6 4.6S12.8 11 14 8c-1.2-3-3.4-4.6-6-4.6Z"
                      fill="none" stroke="currentColor" stroke-width="1.2"/>
                <circle cx="8" cy="8" r="1.7" fill="currentColor"/>
              </svg>
              <span class="griff__wort">Vorschau</span>
            </button>
            {wege.has(n.id) && (
              <button class="griff" type="button" data-faden={n.id}
                      title={`Einen Faden weben, der bei „${n.titel}" beginnt`}>
                <svg viewBox="0 0 16 16" aria-hidden="true" class="griff__zeichen">
                  <path d="M2 12 C 5 12, 5 4, 8 4 S 11 12, 14 12" fill="none"
                        stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                </svg>
                <span class="griff__wort">Faden</span>
              </button>
            )}
            {nachbarschaft[i].length > 0 && (
              <button class="griff" type="button" data-nah-auf={i}
                      title={`Zeigen, was mit „${n.titel}" verwandt ist`}>
                <svg viewBox="0 0 16 16" aria-hidden="true" class="griff__zeichen">
                  <circle cx="8" cy="8" r="1.9" fill="currentColor"/>
                  <circle cx="2.6" cy="4" r="1.3" fill="currentColor" opacity=".55"/>
                  <circle cx="13.4" cy="5" r="1.3" fill="currentColor" opacity=".55"/>
                  <circle cx="4" cy="13" r="1.3" fill="currentColor" opacity=".55"/>
                  <circle cx="12.6" cy="12.4" r="1.3" fill="currentColor" opacity=".55"/>
                  <g stroke="currentColor" stroke-width=".9" opacity=".4">
                    <path d="M8 8 L2.6 4M8 8 L13.4 5M8 8 L4 13M8 8 L12.6 12.4"/>
                  </g>
                </svg>
                <span class="griff__wort griff__wort--bleibt">{nachbarschaft[i].length} verwandt</span>
              </button>
            )}
          </div>
        </li>
      ))}
    </ol>

    <p class="feld__fuss">
      <button id="mehr" type="button">Mehr zeigen</button>
      <span id="standAnzeige" class="feld__stand"></span>
    </p>
  </section>

  {/* ── Der Faden ── */}
  <div class="faeden" id="faeden">
    {faeden.map((faden, fi) => (
      <section class="faden" data-faden={fi} hidden={fi > 0}>
        <ol class="faden__weg">
          {faden.map((s, si) => (
            <li
              class={`station${si === 0 ? " station--auftakt" : ""}`}
              data-tiefe={tiefe(s.datum).toFixed(4)}
              data-monat={s.datum ? monatJahr(s.datum) : ""}
            >
              <a class="station__karte" href={s.url}>
                {s.banner && (
                  <img
                    class={`station__bild${s.eigenesBild ? "" : " station__bild--rubrik"}`}
                    src={s.banner}
                    alt=""
                    width="1200" height="500"
                    loading="lazy"
                    decoding="async"
                  >
                )}

                <div class="kennung">
                  <b>{s.rubrik}</b>
                  {s.datum && <><i>·</i>{langDatum(s.datum)}</>}
                </div>

                <h2 class="station__titel">{s.titel}</h2>
                {s.teaser && <p class="station__teaser">{s.teaser}</p>}

                {/* Der Schritt gehört unter den Titel, nicht über die
                    Rubrikzeile: Dort las er sich als Vorspann der Station,
                    die man gerade verlassen hat. Er sagt, warum der Weg
                    *hierher* führt — also steht er bei dem, wohin er führt. */}
                {s.grund && (
                  <p class={`schritt${s.grund.fund ? " schritt--fund" : ""}${s.grund.satz || s.grund.fund ? "" : " schritt--knapp"}`}>
                    {s.grund.fund && <span class="schritt__marke">im Bestand gefunden</span>}
                    {s.grund.wie}
                  </p>
                )}
              </a>
            </li>
          ))}
        </ol>

        <p class="faden__fuss">
          <span>Sieben Stationen, {monatJahr(faden[0].datum)} bis {monatJahr(faden[faden.length - 1].datum)}</span>
        </p>
      </section>
    ))}

    <p class="start__nochmal">
      <button id="nochmal" type="button">Ein anderer Weg</button>
      <span class="start__zaehler"><b id="fadenNr">1</b> von {faeden.length}</span>
    </p>
  </div>

</main>

<script>
  const wurzel = document.documentElement;

  /* ══ Die Zeitleiste des Fadens ══
     Oben heute, unten der März. Beim Scrollen wandert der Zeiger nach
     unten — man sieht, wie weit man sich vom Neuesten entfernt hat.
     Steht vor dem Ansichtsschalter, weil der sie beim Aufschlagen ruft. */
  const rail = document.getElementById("rail");
  // Weiter oben als auf der Note: Dort steht „0:00", hier „Aug 26" — und
  // der Zeiger der ersten Station säße dem Wort sonst im Gesicht.
  const OBEN = 116, UNTEN = 108;
  const yVon = (p) => `calc(${OBEN}px + (100% - ${OBEN + UNTEN}px) * ${p})`;

  let zeiger = null, marken = [], aktiv = null;
  const sichtbarerFaden = () => document.querySelector(".faden:not([hidden])");

  function leisteBauen(faden) {
    if (!faden) return;
    for (const m of marken) m.remove();
    marken = [];
    for (const st of faden.querySelectorAll(".station")) {
      const m = document.createElement("div");
      m.className = "mark";
      m.style.top = yVon(+st.dataset.tiefe);
      m.title = st.dataset.monat;
      m.onclick = () => st.scrollIntoView({ block: "center", behavior: "smooth" });
      rail.appendChild(m);
      marken.push(m);
      st._marke = m;
    }
    if (!zeiger) {
      zeiger = document.createElement("div");
      zeiger.className = "zeiger";
      zeiger.innerHTML = '<span class="zeiger__zeit"></span>';
      rail.appendChild(zeiger);
    }
    aktiv = null;
    verfolgen();
  }

  function verfolgen() {
    if (wurzel.dataset.ansicht !== "faden") return;
    const sichtbar = sichtbarerFaden();
    if (!sichtbar || !zeiger) return;
    const mitte = innerHeight * 0.42;
    let beste = null, dist = Infinity;
    for (const st of sichtbar.querySelectorAll(".station")) {
      const r = st.getBoundingClientRect();
      if (r.top > innerHeight || r.bottom < 0) continue;
      const d = Math.abs(r.top - mitte);
      if (d < dist) { dist = d; beste = st; }
    }
    if (!beste || beste === aktiv) return;
    aktiv?._marke?.classList.remove("ist");
    aktiv = beste;
    beste._marke?.classList.add("ist");
    zeiger.style.top = yVon(+beste.dataset.tiefe);
    zeiger.querySelector(".zeiger__zeit").textContent = beste.dataset.monat;
  }

  addEventListener("scroll", verfolgen, { passive: true });
  addEventListener("resize", verfolgen);

  /* ══ Das Feld ══ */
  const kacheln = [...document.querySelectorAll(".kachel")];
  const mehr = document.getElementById("mehr");
  const stand = document.getElementById("standAnzeige");
  const balken = document.getElementById("verwandtschaft");
  const balkenTitel = document.getElementById("verwandtschaftTitel");
  const PORTION = 48;
  let rubrik = "";      // "" heißt: alles
  let gezeigt = PORTION;
  let quelle = null;    // Platznummer der Karte, deren Nachbarschaft steht

  /* Alle Kacheln stehen im Dokument, sichtbar ist ein Ausschnitt. Der
     Filter rechnet darum nichts nach — er blendet um, und das merkt man
     nicht. Dasselbe gilt für die Nachbarschaft: Die verwandten Karten
     sind längst da, sie stehen nur woanders. */
  function auslegen() {
    if (quelle !== null) {
      const nah = new Set(kacheln[quelle].dataset.nah.split(",").map(Number));
      kacheln.forEach((k, i) => {
        k.hidden = !(i === quelle || nah.has(i));
        // Die Quelle zuerst, dann ihre Nachbarn in der Reihenfolge, in der
        // der Stern sie gewichtet hat. `order` ordnet das Raster um, ohne
        // dass eine Karte das Dokument wechseln müsste.
        k.style.order = i === quelle ? -1 : 0;
        k.classList.toggle("kachel--quelle", i === quelle);
      });
      mehr.hidden = true;
      stand.textContent = `${nah.size} verwandt`;
      kappungPruefen();
      return;
    }

    let passend = 0, sichtbar = 0;
    for (const k of kacheln) {
      const trifft = !rubrik || k.dataset.rubrik === rubrik;
      if (trifft) passend++;
      const zeigen = trifft && sichtbar < gezeigt;
      k.hidden = !zeigen;
      k.style.order = "";
      k.classList.remove("kachel--quelle");
      if (zeigen) sichtbar++;
    }
    mehr.hidden = sichtbar >= passend;
    // Zählt, was die Auswahl übriglässt — nicht, wie groß das Regal ist.
    stand.textContent = sichtbar >= passend ? `alle ${passend}` : `${sichtbar} von ${passend}`;
    kappungPruefen();
  }

  /* ── Die Welle ──
     Kein Morphen: Wenn achtundvierzig Karten auf acht zusammengehen, gibt
     es nichts, was ineinander überginge. Was stimmt, ist ein Zurücktreten
     und ein Heraufkommen. Der Versatz läuft in Leserichtung. */
  const RUHIG = matchMedia("(prefers-reduced-motion: reduce)").matches;
  function welle(umbauen) {
    if (RUHIG) { umbauen(); return; }
    const vorher = kacheln.filter((k) => !k.hidden);
    vorher.forEach((k, n) => {
      k.style.setProperty("--takt", `${Math.min(n, 14) * 11}ms`);
      k.classList.add("geht");
    });
    setTimeout(() => {
      for (const k of vorher) { k.classList.remove("geht"); k.style.removeProperty("--takt"); }
      umbauen();
      kacheln.filter((k) => !k.hidden)
        .sort((a, b) => (+a.style.order || 0) - (+b.style.order || 0))
        .forEach((k, n) => {
          k.style.setProperty("--takt", `${Math.min(n, 18) * 32}ms`);
          k.classList.add("kommt");
          k.addEventListener("animationend", () => {
            k.classList.remove("kommt");
            k.style.removeProperty("--takt");
          }, { once: true });
        });
    }, 360);
  }

  function verwandtesZeigen(i) {
    welle(() => {
      quelle = i;
      balkenTitel.textContent = kacheln[i].dataset.titel;
      balken.hidden = false;
      auslegen();
    });
    document.getElementById("feld").scrollIntoView({ block: "start", behavior: "smooth" });
  }

  function zurueckInsFeld() {
    welle(() => { quelle = null; balken.hidden = true; auslegen(); });
  }

  document.getElementById("verwandtZu").addEventListener("click", zurueckInsFeld);

  /* ── Abgeschnittene Teaser anfassbar machen ──
     Bei drei Karten je Zeile passen die meisten „Worum es geht" ganz in
     die fünf Zeilen. Nur die wirklich gekappten bekommen den Zeigefinger
     — bei allen anderen verspräche er etwas, das nicht passiert.
     Muss nach jedem Umblenden neu laufen: Eine versteckte Karte hat kein
     Layout, also auch keine messbare Höhe. */
  function kappungPruefen() {
    for (const t of document.querySelectorAll(".kachel:not([hidden]) .kachel__teaser")) {
      if (t.classList.contains("ist-offen")) continue;
      const gekappt = t.scrollHeight - t.clientHeight > 4;
      t.classList.toggle("ist-gekappt", gekappt);
      t.title = gekappt ? "Ganz anzeigen" : "";
    }
  }

  document.getElementById("gitter").addEventListener("click", (e) => {
    const teaser = e.target.closest(".kachel__teaser");
    if (teaser && (teaser.classList.contains("ist-gekappt") || teaser.classList.contains("ist-offen"))) {
      const auf = teaser.classList.toggle("ist-offen");
      teaser.classList.toggle("ist-gekappt", !auf);
      teaser.title = auf ? "Wieder einklappen" : "Ganz anzeigen";
      return;
    }
    const schauKnopf = e.target.closest("[data-schau]");
    if (schauKnopf) { gwSchau.oeffnen(schauKnopf.dataset.schau); return; }
    const nahKnopf = e.target.closest("[data-nah-auf]");
    if (nahKnopf) { verwandtesZeigen(+nahKnopf.dataset.nahAuf); return; }
    const fadenKnopf = e.target.closest("[data-faden]");
    if (fadenKnopf) fadenAbHier(fadenKnopf.dataset.faden, fadenKnopf);
  });

  document.getElementById("filter").addEventListener("click", (e) => {
    const chip = e.target.closest(".chip");
    if (!chip) return;
    rubrik = chip.dataset.rubrik;
    gezeigt = PORTION;
    for (const c of document.querySelectorAll(".chip")) c.classList.toggle("ist-gewaehlt", c === chip);
    // Eine Rubrik zu wählen heißt, das Feld wieder sehen zu wollen.
    welle(() => { quelle = null; balken.hidden = true; auslegen(); });
  });

  mehr.addEventListener("click", () => { gezeigt += PORTION; auslegen(); });

  /* ══ Den Platz im Feld behalten ══
     Wer sich durch dreihundert Karten gescrollt hat, eine Note öffnet und
     zurückkommt, soll dort stehen, wo er war — und nicht wieder oben.

     Das ist nicht nur Bequemlichkeit: Ohne das taugt auch der
     Browser-Zurück-Knopf nichts. Er stellt die Scrollhöhe wieder her, aber
     das Feld baut sich mit achtundvierzig Karten neu auf — die Höhe zeigt
     dann irgendwohin. Also merken wir uns den *Zustand* und stellen die
     Höhe selbst wieder ein.

     Im sessionStorage, nicht im localStorage: Der Platz gehört zu diesem
     Besuch. Morgen fängt man neu an. */
  const PLATZ = "gw-feld";

  function platzSichern() {
    try {
      sessionStorage.setItem(PLATZ, JSON.stringify({ rubrik, gezeigt, quelle, y: Math.round(scrollY) }));
    } catch {}
  }
  // `pagehide` und nicht `beforeunload`: Letzteres verhindert, dass die
  // Seite in den Zurück-Zwischenspeicher darf.
  addEventListener("pagehide", platzSichern);

  let zurueckAuf = null;
  try {
    const p = JSON.parse(sessionStorage.getItem(PLATZ) || "null");
    if (p) {
      rubrik = p.rubrik ?? "";
      gezeigt = Math.max(PORTION, p.gezeigt ?? PORTION);
      quelle = Number.isInteger(p.quelle) ? p.quelle : null;
      zurueckAuf = p.y || 0;
      for (const c of document.querySelectorAll(".chip")) {
        c.classList.toggle("ist-gewaehlt", c.dataset.rubrik === rubrik);
      }
      if (quelle !== null && kacheln[quelle]?.dataset.nah) {
        balkenTitel.textContent = kacheln[quelle].dataset.titel;
        balken.hidden = false;
      } else {
        quelle = null;
      }
    }
  } catch {}

  auslegen();
  kappungPruefen();
  addEventListener("resize", kappungPruefen);

  /* Die Höhe erst, wenn die Karten stehen. Sie brauchen ihre Bilder nicht
     abzuwarten — `width`/`height` an jedem `img` halten den Platz frei,
     das Layout steht also schon vor dem ersten Byte Bild. */
  if (zurueckAuf) {
    history.scrollRestoration = "manual";   // sonst zöge der Browser dagegen
    scrollTo({ top: zurueckAuf, behavior: "instant" });
  }

  /* ══ Die Vorschau ══ steht in leser.js (`gwSchau`) — Startseite und
     Note teilen sie sich seit dem 05.09. */

  /* Aufs Geratewohl — aus dem, was gerade gefiltert ist. Sonst führte der
     Würfel aus einer Rubrik hinaus, die man ausdrücklich gewählt hat. */
  document.getElementById("wuerfel").addEventListener("click", (e) => {
    e.preventDefault();
    const topf = kacheln.filter((k) => !rubrik || k.dataset.rubrik === rubrik);
    location.href = topf[Math.floor(Math.random() * topf.length)].querySelector("a").href;
  });

  /* ── Ein anderer Weg ──
     Neun Fäden liegen fertig im Dokument, einer je Rubrik als Eingang.
     Sie im Browser neu zu berechnen hieße, den halben Bestand mitzuliefern
     — für eine Geste, die neun Zustände hat. */
  const alleFadenTeile = [...document.querySelectorAll(".faden")];
  const nr = document.getElementById("fadenNr");
  let i = 0;
  document.getElementById("nochmal")?.addEventListener("click", () => {
    alleFadenTeile[i].hidden = true;
    i = (i + 1) % alleFadenTeile.length;
    alleFadenTeile[i].hidden = false;
    nr.textContent = String(i + 1);
    leisteBauen(alleFadenTeile[i]);
    alleFadenTeile[i].scrollIntoView({ block: "start", behavior: "smooth" });
  });

  /* ══ Ein Faden ab dieser Karte ══
     Die neun fertigen Wege beginnen bei der jüngsten Note jeder Rubrik.
     Wer bei einer bestimmten anfangen will, bekommt seinen eigenen — die
     Wege für alle Notes liegen in `faeden.json` und werden beim ersten
     Klick geholt, nicht beim Laden der Seite. */
  const MONATE = ["Januar","Februar","März","April","Mai","Juni","Juli",
                  "August","September","Oktober","November","Dezember"];
  const monatJahr = (d) => { const [j, m] = d.split("-"); return `${MONATE[+m - 1]} ${j}`; };
  const langDatum = (d) => {
    if (!d) return null;
    const [j, m, t] = d.split("-");
    return `${+t}. ${MONATE[+m - 1]} ${j}`;
  };
  const VON = Date.parse(rail.dataset.von), BIS = Date.parse(rail.dataset.bis);
  const tiefe = (d) => (d ? (BIS - Date.parse(d)) / (BIS - VON || 1) : 0);

  let wegeDaten = null;
  const nochmalBlock = document.getElementById("nochmal").parentElement;

  async function fadenAbHier(id, knopf) {
    if (!wegeDaten) {
      knopf.classList.add("griff--laedt");
      try {
        wegeDaten = await (await fetch("/faeden.json")).json();
      } catch {
        // Ehrlich sagen, dass es nicht ging, statt stumm nichts zu tun.
        knopf.classList.remove("griff--laedt");
        knopf.lastChild.textContent = " nicht erreichbar";
        return;
      }
      knopf.classList.remove("griff--laedt");
    }
    const weg = wegeDaten.f[id];
    if (!weg) return;

    // Die neun stehenden Wege treten beiseite, der eigene tritt an ihre
    // Stelle — und mit ihnen der Zähler, der nur für sie gilt.
    for (const f of alleFadenTeile) f.hidden = true;
    nochmalBlock.hidden = true;
    document.getElementById("eigenerFaden")?.remove();

    const teil = document.createElement("section");
    teil.className = "faden";
    teil.id = "eigenerFaden";
    teil.innerHTML = `<ol class="faden__weg">${weg.map(([nr, grund, fund], s) => {
      const n = wegeDaten.n[nr];
      const bild = n.b
        ? `<img class="station__bild${n.e ? "" : " station__bild--rubrik"}" src="${n.b}"
                alt="" width="1200" height="500" loading="lazy" decoding="async">` : "";
      const schritt = grund
        ? `<p class="schritt${fund ? " schritt--fund" : ""}">${
             fund ? '<span class="schritt__marke">im Bestand gefunden</span>' : ""}${grund}</p>`
        : "";
      return `<li class="station${s === 0 ? " station--auftakt" : ""}"
                  data-tiefe="${tiefe(n.d).toFixed(4)}" data-monat="${n.d ? monatJahr(n.d) : ""}">
        <a class="station__karte" href="${n.u}">${bild}
          <div class="kennung"><b>${n.r}</b>${n.d ? `<i>·</i>${langDatum(n.d)}` : ""}</div>
          <h2 class="station__titel">${n.t}</h2>
          ${n.x ? `<p class="station__teaser">${n.x}</p>` : ""}
          ${schritt}
        </a></li>`;
    }).join("")}</ol>
    <p class="faden__fuss"><span>${weg.length} Stationen ab dieser Note</span></p>`;

    document.getElementById("faeden").prepend(teil);
    ansichtSetzen("faden", false);   // nicht merken: das war ein Ausflug, keine Wahl
    scrollTo({ top: 0, behavior: "smooth" });
    leisteBauen(teil);
  }

  /* ══ Ansicht: Feld oder Faden ══
     Der Grundzustand ist das Feld. Wer den Faden wählt, bekommt ihn beim
     nächsten Besuch wieder — die Wahl gehört dem Leser, nicht der Seite.
     Steht am Ende, weil das Aufräumen alles kennen muss, was oben entsteht. */
  const ansichtKnopf = document.getElementById("ansicht");

  function ansichtSetzen(a, merken) {
    wurzel.dataset.ansicht = a;
    ansichtKnopf.setAttribute("aria-pressed", String(a === "faden"));
    if (merken) { try { localStorage.setItem("gw-ansicht", a); } catch {} }
    if (a === "faden") {
      leisteBauen(sichtbarerFaden());
    } else {
      // Ein eigener Faden gehört zu dem Klick, der ihn gewebt hat. Bliebe
      // er liegen, fände man beim nächsten Aufschlagen einen Weg vor, den
      // man nicht mehr angefordert hat.
      document.getElementById("eigenerFaden")?.remove();
      nochmalBlock.hidden = false;
      alleFadenTeile.forEach((f, n) => { f.hidden = n !== i; });
    }
  }

  // Der Kopf hat den gespeicherten Zustand schon gesetzt; hier wird der
  // Knopf nur noch darauf eingestellt.
  if (wurzel.dataset.ansicht === "faden") ansichtSetzen("faden", false);

  ansichtKnopf.addEventListener("click", () => {
    ansichtSetzen(wurzel.dataset.ansicht === "faden" ? "feld" : "faden", true);
    scrollTo({ top: 0, behavior: "smooth" });
  });
</script>

<Fusszeile fest />
<Schau />

<Suche />

<script src={`/leser.js?v=${BUILD}`} is:inline></script>
<script is:inline>
  /* Die Klappe über den Rubriken (nur Telefon): auf, zu, und nach jeder
     Wahl das Etikett nachziehen und wieder zu. */
  {
    const lenkung = document.getElementById("lenkung"), klappe = document.getElementById("klappe");
    const wort = document.getElementById("klappeWort"), zahl = document.getElementById("klappeZahl");
    const punkt = document.getElementById("klappePunkt");
    klappe.addEventListener("click", () => {
      const offen = lenkung.classList.toggle("ist-offen");
      klappe.setAttribute("aria-expanded", String(offen));
    });
    document.getElementById("filter").addEventListener("click", (e) => {
      if (!e.target.closest(".chip")) return;
      requestAnimationFrame(() => {
        const c = document.querySelector(".chip.ist-gewaehlt");
        if (!c) return;
        const r = c.dataset.rubrik || "";
        wort.textContent = r || "Alles";
        zahl.textContent = c.querySelector("i")?.textContent ?? "";
        punkt.hidden = !r;
        punkt.className = r ? `regal__punkt regal__punkt--${r.toLowerCase()}` : "regal__punkt";
        lenkung.classList.remove("ist-offen");
        klappe.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>
</body>
