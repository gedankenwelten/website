<script src={`/leser.js?v=${BUILD}`} is:inline></script>
<script src={`/themenwolke.js?v=${BUILD}`} is:inline></script>
<script is:inline>
  /* Die Klappe über den Rubriken (nur Telefon): auf, zu, und nach jeder
     Wahl das Etikett nachziehen und wieder zu. */
  {
    const lenkung = document.getElementById("lenkung"), klappe = document.getElementById("klappe");
    const wort = document.getElementById("klappeWort"), zahl = document.getElementById("klappeZahl");
    const punkt = document.getElementById("klappePunkt");
    klappe.addEventListener("click", () => {
      const offen = lenkung.classList.toggle("ist-offen");
      klappe.setAttribute("aria-expanded", String(offen));
    });
    const etikett = () => {
      const c = document.querySelector(".chip.ist-gewaehlt");
      if (!c) return;
      const r = c.dataset.rubrik || "";
      wort.textContent = r || "Alles";
      zahl.textContent = c.querySelector("i")?.textContent ?? "";
      punkt.hidden = !r;
      punkt.className = r ? `regal__punkt regal__punkt--${r.toLowerCase()}` : "regal__punkt";
    };
    document.getElementById("filter").addEventListener("click", (e) => {
      if (!e.target.closest(".chip")) return;
      requestAnimationFrame(() => {
        etikett();
        lenkung.classList.remove("ist-offen");
        klappe.setAttribute("aria-expanded", "false");
      });
    });
    // Das Feld (ein Modul, läuft also *nach* diesem Skript) ruft es nach
    // jedem Umblenden — auch wenn die Rubrik aus der Adresse kommt.
    window.gwEtikett = etikett;
    etikett();
  }
</script>
