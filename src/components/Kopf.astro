---
/**
 * Der Kopf jeder Seite — was Browser, Suchmaschinen, Feed-Reader und
 * geteilte Links über sie wissen sollen. Ein Ort statt vier: Note,
 * Startseite, Rubrik und Beiseiten hatten je einen eigenen Kopf, und
 * keiner trug alles.
 */
import { SITE } from "../lib/site.mjs";
import Vorspann from "./Vorspann.astro";

const {
  titel,
  beschreibung = SITE.satz,
  bild = null,            // absoluter Pfad, z. B. /assets/…
  art = "article",
  rubrik = null,          // für den Rubrik-Feed als Alternative
  datum = null,           // `aktualisiert:` der Note (Date oder Text)
  erstellt = null,
} = Astro.props;

const voll = titel ? `${titel} · ${SITE.name}` : SITE.name;
// Die saubere Adresse, wie die Sitemap sie nennt. Astro baut Dateien
// (`/Denker/X.html`); der Canonical trug die Endung mit und widersprach
// damit der Sitemap — und jedem geteilten Link hing sie an.
const pfad = Astro.url.pathname.replace(/(?:\/index)?\.html$/, "") || "/";
const hier = new URL(pfad, SITE.url).href;
const bildUrl = new URL(bild ?? SITE.ogBild, SITE.url).href;

/* Was Bing (und damit DuckDuckGo) und Google über die Seite lesen, um ihr
   im Treffer ein Vorschaubild zu geben: das og:image allein reicht ihnen
   selten, sie wollen es als Hauptbild der Seite ausgezeichnet sehen
   (schema.org). Eine Vita ist ein Profil einer Person, eine Note ein
   Artikel, die Startseite die Website selbst. Der Satz der Seite ist
   kein Inhalt — wo die Note keinen eigenen hat, schweigen wir lieber. */
const iso = (w) => {
  if (w instanceof Date) return w.toISOString().slice(0, 10);
  const t = String(w ?? "").trim();
  if (/^\d{4}-\d{2}-\d{2}/.test(t)) return t.slice(0, 10);
  const m = t.match(/^(\d{1,2})\.(\d{1,2})\.(\d{4})$/);
  return m ? `${m[3]}-${m[2].padStart(2, "0")}-${m[1].padStart(2, "0")}` : undefined;
};
const herausgeber = {
  "@type": "Organization",
  name: SITE.name,
  url: SITE.url,
  logo: { "@type": "ImageObject", url: new URL("/icon.png", SITE.url).href },
};
const eigeneBeschreibung = beschreibung !== SITE.satz ? beschreibung : undefined;
const hauptbild = bild ? { "@type": "ImageObject", url: bildUrl } : undefined;
let daten;
if (art === "article" && rubrik === "DenkerVita") {
  daten = {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    url: hier,
    name: titel,
    description: eigeneBeschreibung,
    inLanguage: "de",
    dateModified: iso(datum),
    primaryImageOfPage: hauptbild,
    image: bild ? bildUrl : undefined,
    mainEntity: { "@type": "Person", name: titel?.replace(/\s+—\s+DenkerVita$/, ""), image: bild ? bildUrl : undefined },
    isPartOf: { "@type": "WebSite", name: SITE.name, url: SITE.url },
  };
} else if (art === "article") {
  daten = {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: titel,
    description: eigeneBeschreibung,
    url: hier,
    mainEntityOfPage: hier,
    inLanguage: "de",
    image: [bildUrl],
    datePublished: iso(erstellt),
    dateModified: iso(datum),
    author: herausgeber,
    publisher: herausgeber,
    isPartOf: { "@type": "WebSite", name: SITE.name, url: SITE.url },
  };
} else if (pfad === "/") {
  daten = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.url,
    description: beschreibung,
    inLanguage: "de",
    publisher: herausgeber,
  };
}
// `<` maskieren — ein Titel mit `</script>` darf den Block nicht schließen.
const jsonld = daten && JSON.stringify(daten).replace(/</g, "\\u003c");
---
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{voll}</title>
<meta name="description" content={beschreibung}>
<link rel="canonical" href={hier}>
{/* Große Bildvorschau ausdrücklich erlauben — ohne die Angabe zeigen
    Suchmaschinen oft nur ein Daumennagel-Bild oder gar keins. */}
<meta name="robots" content={SITE.noindex ? "noindex, follow, max-image-preview:large" : "max-image-preview:large"}>

{/* Die Leseschrift vorab holen — sonst steht der Text kurz in der
    Ersatzschrift und springt. Nur Latin, nur die zwei Schnitte, die
    jede Seite braucht. */}
<link rel="preload" href="/schrift/literata-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/schrift/literata-italic-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="icon" href="/icon.png" type="image/png">
<link rel="icon" href="/gedankenwelten-favicon-64.png" sizes="64x64" type="image/png">
<link rel="apple-touch-icon" href="/icon.png">
<meta name="theme-color" content="#faf7f1" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#16140f" media="(prefers-color-scheme: dark)">

<meta property="og:site_name" content={SITE.name}>
<meta property="og:title" content={titel ?? SITE.name}>
<meta property="og:description" content={beschreibung}>
<meta property="og:type" content={art}>
<meta property="og:url" content={hier}>
<meta property="og:image" content={bildUrl}>
<meta property="og:locale" content="de_DE">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={titel ?? SITE.name}>
<meta name="twitter:description" content={beschreibung}>
<meta name="twitter:image" content={bildUrl}>
{bild && <meta property="og:image:width" content="1200">}
{bild && <meta property="og:image:height" content="500">}
{jsonld && <script type="application/ld+json" set:html={jsonld} />}

<link rel="alternate" type="application/rss+xml" title={`${SITE.name} — alle Notes`} href={`${SITE.url}/index.xml`}>
{rubrik && <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — ${rubrik}`} href={`${SITE.url}/${rubrik}/index.xml`}>}

{/* Umami: cookielos, ohne IP, ohne Profil — dieselbe Instanz wie bisher.
    So wenig wie möglich wissen: Bildschirmgröße und Sprache verlassen den Browser
    nicht (Datenschutzerklärung, 14.09.2026). Gerätetyp und Stadt bleiben — der eine
    kommt aus der Browser-Kennung, die andere von Cloudflare. */}
{/* Nicht gezählt werden: einmal ?nicht-zaehlen an eine Adresse hängen, dann
    schweigt Umami in diesem Browser (sein eigener Schalter `umami.disabled`).
    Für Andreas' eigene Geräte — und für jeden, der es möchte; steht so in der
    Datenschutzerklärung. ?wieder-zaehlen macht es rückgängig. */}
<script is:inline>try { const u = new URL(location.href), q = u.searchParams; if (q.has("nicht-zaehlen")) localStorage.setItem("umami.disabled", "1"); if (q.has("wieder-zaehlen")) localStorage.removeItem("umami.disabled"); if (q.has("nicht-zaehlen") || q.has("wieder-zaehlen")) { q.delete("nicht-zaehlen"); q.delete("wieder-zaehlen"); history.replaceState(null, "", u.pathname + (q.size ? "?" + q : "") + u.hash); } } catch {}</script>
{/* Der eigene Fernseher (fernseher.js): einmal #fernseher=<Base64 von {"u":Adresse,"k":Schlüssel}>
    an eine Adresse hängen, dann kennt dieser Browser seinen Empfänger. #fernseher=aus vergisst ihn.
    Im Fragment, damit es nie einen Server erreicht — und vor Umami weggeräumt, damit es nicht gezählt wird. */}
<script is:inline>try { const m = /^#fernseher=(.+)$/.exec(location.hash); if (m) { if (m[1] === "aus") localStorage.removeItem("gw-fernseher"); else { const z = JSON.parse(atob(m[1].replace(/-/g, "+").replace(/_/g, "/"))); if (/^https:\/\/[^/]+$/.test(z.u) && z.k) localStorage.setItem("gw-fernseher", JSON.stringify({ u: z.u, k: z.k })); } history.replaceState(null, "", location.pathname + location.search); } } catch {}</script>
<script is:inline>window.umamiKnapp = (_typ, p) => { delete p.screen; delete p.language; return p; };</script>
<script defer src={`${SITE.umami.host}/script.js`} data-website-id={SITE.umami.id} data-before-send="umamiKnapp"></script>

<Vorspann />
