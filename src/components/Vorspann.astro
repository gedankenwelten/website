---
/**
 * Was vor dem ersten Bild feststehen muss.
 *
 * Zwei Dinge entscheidet erst der Leser, nicht der Build — sein Thema und
 * sein Kalendertag. Beides muss aber schon stehen, bevor gezeichnet wird:
 *
 * - Das Thema stand bisher als `hell` im HTML und wurde erst am Fuß der
 *   Seite von `leser.js` umgestellt. Wer dunkel liest, sah bei jedem
 *   Seitenwechsel ein weißes Aufblitzen.
 * - Die Wortmarke des Tages entscheidet, welches von zwölf Bildern geholt
 *   wird. Stünde eine Vorgabe im `src`, lüde der Browser sie los, bevor
 *   Javascript sie korrigieren könnte — zwei Bilder für eine Marke.
 *
 * Darum hier, inline und blockierend. Die paar Zeilen kosten weniger als
 * das, was sie verhindern.
 */
import { WORTMARKEN } from "../lib/wortmarke.mjs";
---
<script is:inline define:vars={{ WORTMARKEN }}>
  const w = document.documentElement;
  try {
    const t = localStorage.getItem("gw-theme");
    if (t) w.dataset.theme = t;
  } catch {}
  // Dieselbe Rechnung wie `wortmarkeDesTages()` in src/lib/wortmarke.mjs
  // und wie in der Quartz-Fassung: Tag im Monat, minus eins, modulo Pool.
  w.dataset.wm = WORTMARKEN[(new Date().getDate() - 1) % WORTMARKEN.length];
</script>
