---
/**
 * Die Kopfleiste — der einzige Ort, der auf jeder Seite steht.
 *
 * Vorher gab es auf einer Note genau einen Navigations-Link: die Rubrik in
 * der Kennzeile. Die scrollt nach dem ersten Absatz weg, und danach führte
 * bis zum Stern am Fuß nichts mehr irgendwohin — zurück kam man nur über
 * den Browser-Knopf.
 *
 * Aufgeteilt wie ein Kopf es soll: links, wo man ist und wie man weiter
 * kommt (Marke, Rubriken, die eigene Spur), rechts das Werkzeug (Suche,
 * Licht). Bewusst eine Zeile und kein Kasten — der Datei-Explorer war der
 * stärkste Altbacken-Treiber der alten Fassung, und ein Anker ist kein
 * Werkzeugkasten. Sie liegt ohne Grund im Papier, solange man oben ist,
 * und bekommt ihre Kante erst, wenn Text unter ihr durchläuft.
 */
import { alleRubriken } from "../lib/rubriken.mjs";

const { rubrik = null, teilen = false } = Astro.props;
const rubriken = alleRubriken();
---
<header class="kopfleiste" id="kopfleiste">

  <nav class="kopfleiste__weg" aria-label="Hauptnavigation">
    {/* Nur das Wort, in der Schrift der Seite. Die gemalte Marke stand hier
        bis zum 05.09. — das einzige laute Stück auf einer Seite, die sonst
        flüstert, und auf der Startseite stand der Name zehn Zeilen tiefer
        noch einmal. Jetzt hat sie *einen* Ort: den Auftakt der Startseite,
        wo sie täglich wechseln darf. Die Kopfleiste sagt nur, wo man ist. */}
    <a class="kopfleiste__marke" href="/" aria-label="Gedankenwelten — zur Startseite">
      <span class="kopfleiste__marke-wort">Gedanken&shy;welten</span>
    </a>

    {/* Ein Element, zwei Aufgaben: Es *sagt*, in welcher Rubrik man steht,
        und es *führt* in jede andere. Zwei getrennte Anzeigen — „Rubriken"
        neben „Denker" — sagten zusammen weniger als diese eine. */}
    <div class="rubrikwahl" id="rubrikwahl">
      <button class="rubrikwahl__knopf" type="button"
              aria-expanded="false" aria-controls="rubrikwahlListe">
        {rubrik
          ? <><span class={`regal__punkt regal__punkt--${rubrik.toLowerCase()}`}></span>{rubrik}</>
          : <span>Rubriken</span>}
        <i class="rubrikwahl__pfeil" aria-hidden="true"></i>
      </button>

      <div class="rubrikwahl__liste" id="rubrikwahlListe" hidden>
        {rubriken.map((r) => (
          <a href={`/${r.name}`} aria-current={r.name === rubrik ? "page" : null}>
            <span class={`regal__punkt regal__punkt--${r.name.toLowerCase()}`}></span>
            <span class="rubrikwahl__name">{r.name}</span>
            <i>{r.anzahl}</i>
          </a>
        ))}
      </div>
    </div>

    {/* Die eigene Spur. Anders als der Browser-Knopf zeigt sie, wohin sie
        führt — man muss sich nicht erinnern, sondern liest es ab. */}
    <a class="kopfleiste__spur" id="kopfleisteSpur" hidden></a>
  </nav>

  <div class="kopfleiste__werkzeug">
    {/* Ein Feld, kein Knopf. Bei 761 Notes ist die Suche ein Hauptzugang,
        und ein Hauptzugang, der wie ein Zahnrad aussieht, wird nicht
        gefunden. Es ist eine Schaltfläche in Feldgestalt: Der Klick
        öffnet die Suchschicht, in der schon der Fokus steht — ein zweites
        echtes Eingabefeld daneben würde nur fragen, in welches man tippt. */}
    <button class="suchfeld" type="button" data-suche-auf aria-label="Im Bestand suchen">
      <svg class="suchfeld__lupe" viewBox="0 0 16 16" aria-hidden="true">
        <circle cx="7" cy="7" r="4.6" fill="none" stroke="currentColor" stroke-width="1.4"/>
        <path d="M10.4 10.4 L14 14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
      <span class="suchfeld__wort">Im Bestand suchen</span>
      <kbd class="suchfeld__taste">⌘K</kbd>
    </button>

    {/* Schrift und Licht. Auf dem Desktop stehen sie offen in der Leiste
        (das Gehäuse ist dort `display: contents`, also unsichtbar). Auf dem
        Telefon reicht eine Zeile nicht für Marke, Rubrik, Suche, drei A und
        „Dunkel" — die Rubrikwahl schob sich über Lupe und Schriftgrad, und
        die Suche war nicht mehr zu treffen (Andreas, 16.09.2026). Dort
        klappen beide hinter ein „Aa" wie in der Leseansicht des Browsers. */}
    {/* Teilen — auf dem Telefon das eigene Teilen-Menü des Geräts
        (WhatsApp, Signal, Mail, AirDrop …), am Rechner die Adresse in die
        Zwischenablage. Keine Knöpfe fremder Netzwerke: die kämen mit
        Skripten und Tracking, und das Menü des Geräts kann ohnehin mehr. */}
    {teilen && (
      <button class="teilen" type="button" data-teilen="kopf" aria-label="Diese Note teilen" title="Teilen">
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M8 1.8v8.4M5.2 4.4 8 1.6l2.8 2.8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M5.4 6.6H4a1 1 0 0 0-1 1v5.8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V7.6a1 1 0 0 0-1-1h-1.4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
      </button>
    )}

    <div class="anzeige" id="anzeige">
      <button class="anzeige__knopf" type="button" aria-expanded="false"
              aria-controls="anzeigeFeld" aria-label="Schrift und Licht">Aa</button>
      <div class="anzeige__feld" id="anzeigeFeld">
        {/* Der Schriftgrad — drei Stufen wie am Lesegerät, die mittlere ist
            die Vorgabe. Was gewählt ist, merkt sich der Browser (gw-schrift);
            gesetzt wird es im Vorspann, noch vor dem ersten Bild. */}
        <div class="kopfleiste__grad" role="group" aria-label="Schriftgröße">
          <button type="button" data-schrift="klein" aria-label="Schrift kleiner" title="Kleine Schrift">A</button>
          <button type="button" data-schrift="mittel" aria-label="Schrift normal" title="Normale Schrift">A</button>
          <button type="button" data-schrift="gross" aria-label="Schrift größer" title="Große Schrift">A</button>
        </div>

        <button id="theme" class="kopfleiste__licht">Dunkel</button>
      </div>
    </div>
  </div>
</header>
