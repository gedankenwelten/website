---
import "../styles/note.css";
import "../styles/stern.css";
import Stern from "../components/Stern.astro";
import { filterbareThemen } from "../lib/rubriken.mjs";
import { ladeGraph } from "../lib/graph.mjs";
import Suche from "../components/Suche.astro";
import Kopfleiste from "../components/Kopfleiste.astro";
import Vorspann from "../components/Vorspann.astro";
import Schau from "../components/Schau.astro";

const { note, kopf } = Astro.props;
const d = note.data;

const zeitstempel = kopf.zeitstempel ?? [];
// Die Videodauer steht nirgends im Frontmatter. Bis wir sie beim Build holen,
// leiten wir sie aus dem spätesten zitierten Moment ab — knapp zu kurz, aber
// ehrlich: die Leiste endet dort, wo die Note aufhört zuzuhören.
const dauer = zeitstempel.length ? Math.ceil(Math.max(...zeitstempel) * 1.02) : 0;
const mmss = (s) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;
const hm = (s) => `${Math.floor(s / 3600)}:${String(Math.floor((s % 3600) / 60)).padStart(2, "0")}`;

const datum = d.aktualisiert instanceof Date
  ? d.aktualisiert.toLocaleDateString("de-DE", { day: "numeric", month: "long", year: "numeric" })
  : d.aktualisiert ?? null;

const rubrik = note.id.split("/")[0];
/* Die Marken unter dem Text zeigten bisher auf `/tags/…` — eine Seite,
   die es nie gab. Jetzt führen sie in die eigene Rubrik, auf dieses Thema
   gefiltert. Was dort nichts trennt (der Typ-Tag, das Jahr, der Autor),
   bleibt stehen, wird aber nicht zum Link. */
const filterbar = filterbareThemen(rubrik);

/* Kataloge und die beiden alten Quartz-Deckblätter bleiben aus dem
   Suchindex. „Zeitgeist — Übersicht" enthält 276 Titel und träfe damit
   auf fast jede Anfrage — als Treffer wäre das keine Fundstelle,
   sondern ein Inhaltsverzeichnis, das sich vordrängt. */
const nichtSuchbar = ladeGraph().katalog.has(note.id)
  || note.id.split("/").pop().toLowerCase() === "index";
---
<!DOCTYPE html>
<html lang="de" data-theme="hell">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{d.title} · Gedankenwelten</title>
  {d.description && <meta name="description" content={d.description}>}
  <meta name="robots" content="noindex, follow">
  <Vorspann />
</head>
<body>

<div class="zu-schmal">
  <p>Diese Fassung ist für den großen Schirm gemacht — sie braucht ihre Ränder.<br><br>
  <span style="font-size:.85rem">Fenster auf mindestens 1180&nbsp;px verbreitern.</span></p>
</div>

<Kopfleiste rubrik={rubrik} />

{dauer > 0 && (
  <div class="rail" id="rail" data-dauer={dauer}>
    <div class="rail__cap rail__cap--oben">0:00</div>
    <div class="rail__line"></div>
    <div class="rail__cap rail__cap--unten">{hm(dauer)}</div>
  </div>
)}

<article class="blatt">
  <header class="strang">
    {kopf.banner && <img class="banner" src={kopf.banner} alt="">}

    <div class="kennung">
      {/* Die Rubrikmarke ist die einzige Navigation im Kopf der Note —
          von hier führt sie jetzt in die Rubrik statt nur zu sagen, in
          welcher man ist. */}
      <b><a class="kennung__rubrik" href={`/${rubrik}`}>{rubrik}</a></b>
      {datum && <><i>·</i>{datum}</>}
      {dauer > 0 && <><i>·</i>{hm(dauer)} h</>}
      {zeitstempel.length > 0 && <><i>·</i>{zeitstempel.length} Belegstellen</>}
    </div>

    <h1>{d.title}</h1>
    {d.description && <p class="standfirst">{d.description}</p>}
  </header>

  {/* Was die Suche liest: der Text der Note, nichts sonst. Der Stern
      steht außerhalb und bliebe ohnehin draußen; die Marken darunter
      sind Navigation und würden als Treffer nur Wortsalat ergeben.
      Die Rubrik kommt als Filter mit, das Datum zum Sortieren. */}
  <div class="strang" id="text"
       data-pagefind-body={nichtSuchbar ? undefined : true}
       data-pagefind-ignore={nichtSuchbar ? true : undefined}
       data-pagefind-filter={`Rubrik:${rubrik}`}
       data-pagefind-meta={`rubrik:${rubrik}`}>
    {/* Titel, Datum und Banner für die Trefferliste. Über Attribute und
        nicht als `schlüssel:wert` im Text: „Isabel Wilkerson — Race,
        Caste and Social Justice" enthält ein Komma, und das trennt dort
        zwei Angaben. */}
    <span hidden
          data-pagefind-meta="titel[data-wert]" data-wert={d.title}></span>
    {datum && <span hidden
          data-pagefind-meta="datum[data-wert]" data-wert={datum}></span>}
    {kopf.banner && <span hidden
          data-pagefind-meta="bild[data-wert]" data-wert={kopf.banner}></span>}

    <slot />

    {d.tags?.length > 0 && (
      <div class="marken-zeile" data-pagefind-ignore>
        {d.tags.map((t) => filterbar.has(t)
          ? <a href={`/${rubrik}?thema=${encodeURIComponent(t)}`}>{t}</a>
          : <span>{t}</span>)}
      </div>
    )}
  </div>

  {/* Alle Verbindungen beisammen, an einem festen Platz. Aus dem
      Suchindex heraus (`data-pagefind-ignore`): Die Begründungen stehen
      in *ihren* Notes noch einmal, und als Treffer wäre diese hier eine
      Fundstelle für einen Text, der woanders steht. */}
  {kopf.verbindungen?.length > 0 && (
    <aside class="verwandt" data-pagefind-ignore>
      <div class="verwandt__halt">
        <h2 class="verwandt__kopf">Verwandt <i>{kopf.verbindungen.length}</i></h2>
        {/* Titel stehen, Begründungen liegen zusammengeklappt darunter.
            Acht ganze Absätze in der Randspalte waren eine Wand neben dem
            Text — und sie versteckten, dass der Kasten *reagiert*: Wenn
            ohnehin alles offen ist, sieht man nicht, was gerade aufgeht.
            Jetzt öffnet sich der eine Eintrag, der nah ist — der Stern
            berührt ihn, die Maus liegt darauf, oder der Text verweist
            gerade auf ihn. Der Punkt davor nennt die Rubrik, in derselben
            Sprache wie die Kopfleiste. Der innere `span` ist für die
            Klappbewegung: Das Gitter braucht ein Kind, das es auf null
            Zeilen drücken kann. */}
        <ol class="verwandt__liste">
          {kopf.verbindungen.map((v) => {
            const rub = (v.url ?? "").split("/")[1]?.toLowerCase();
            return (
              <li>
                <a href={v.url ?? "#"}>
                  <span class="verwandt__titel">
                    {rub && <span class={`regal__punkt regal__punkt--${rub}`} aria-hidden="true"></span>}
                    {v.titel}
                  </span>
                  {v.warum && <span class="verwandt__warum"><span>{v.warum}</span></span>}
                </a>
              </li>
            );
          })}
        </ol>
      </div>
    </aside>
  )}

  <Stern id={note.id} />
</article>

<figure class="guck" id="guck"><img id="guckBild" alt=""><figcaption id="guckZeit"></figcaption></figure>

{kopf.video && (
  <div class="begleiter" id="begleiter" data-video={kopf.video}>
    <div class="begleiter__knopf">▶</div>
    <div class="begleiter__buehne">
      <div id="buehne"></div>
      <div class="begleiter__leiste">
        <span>bei <b id="beiZeit">0:00</b></span>
        <span class="begleiter__zu" id="zu">schließen</span>
      </div>
    </div>
  </div>
)}

<Schau />
<Suche />

<script src="/leser.js" is:inline></script>
</body>
</html>
